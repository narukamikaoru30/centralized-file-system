# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Database
# Replace <db_username> and <db_password>; URL-encode special password characters.
MONGO_URI=mongodb://<db_username>:<db_password>@ac-eirs6dd-shard-00-00.hjuvact.mongodb.net:27017,ac-eirs6dd-shard-00-01.hjuvact.mongodb.net:27017,ac-eirs6dd-shard-00-02.hjuvact.mongodb.net:27017/centralize_file_system?ssl=true&replicaSet=atlas-9p65d0-shard-0&authSource=admin&appName=centralized-cluster

# Object storage (Cloudflare R2 / S3-compatible)
# Leave blank for local development; required when NODE_ENV=production.
# Cloudflare account ID: 4d04df6027c62630b675f747baf8b72d
R2_ENDPOINT=https://4d04df6027c62630b675f747baf8b72d.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=uploads

# JWT access + refresh lifecycle
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=centralized-file-system
JWT_AUDIENCE=centralized-file-system-web
JWT_CLOCK_TOLERANCE_SECONDS=90

# JWT asymmetric keys (RS256)
# You can provide inline PEM values with \n escapes, or file paths.
JWT_ACTIVE_KID=local-dev-key-1
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Optional map for key rotation: {"kid-1":"./keys/public1.pem","kid-2":"-----BEGIN PUBLIC KEY-----\\n..."}
JWT_PUBLIC_KEYS_JSON=

# Upload controls
UPLOAD_DUPLICATE_WINDOW_MINUTES=10

# Optional one-time super admin seeding
# Set to true only when you intentionally want automatic seed creation.
ENABLE_DEFAULT_SUPERADMIN_SEED=false
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@doj-ppa.gov.ph

# Email (nodemailer)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@doj-ppa.gov.ph

# Logging
LOG_LEVEL=info

# ============================================
# BLOCKCHAIN INTEGRATION (Polygon Mainnet)
# ============================================

# Blockchain Network Configuration
BLOCKCHAIN_NETWORK=polygon-mainnet
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGONSCAN_API_KEY=

# Smart Contract Address
# Set after deploying: npx hardhat run scripts/deploy-contract.js --network polygon-mainnet
FILEREGISTRY_ADDRESS=

# Blockchain Wallet Configuration (IMPORTANT: Keep private!)
# This wallet signs all blockchain transactions and pays gas fees
# Generate from Metamask: Settings > Security & Privacy > Show Private Key
WALLET_PRIVATE_KEY=

# Blockchain Transaction Queue Settings
BLOCKCHAIN_BATCH_SIZE=10
BLOCKCHAIN_PROCESS_INTERVAL=5000
BLOCKCHAIN_MAX_RETRIES=3
BLOCKCHAIN_GAS_LIMIT=500000
BLOCKCHAIN_CONFIRMATION_BLOCKS=2

# Feature Flags
ENABLE_BLOCKCHAIN=false
