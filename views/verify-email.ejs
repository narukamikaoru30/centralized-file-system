<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Verify Email | PPO Regional FileSystem',
    description: 'Verify your email address to finish account setup.',
    cssFiles: ['/css/register.css', '/css/system-refresh.css']
  }) %>
</head>
<body>
  <a href="/auth/register" class="back-link">
    <i class="ri-arrow-left-line" aria-hidden="true"></i>
    Back to Registration
  </a>

  <main class="container">
    <section class="register-card" aria-labelledby="verifyEmailTitle">
      <header class="register-header">
        <div class="logo-wrapper"><i class="ri-mail-check-line" aria-hidden="true"></i></div>
        <h1 id="verifyEmailTitle">Verify your email</h1>
        <p>Enter the six-digit code sent to <strong><%= email %></strong> to create your account.</p>
      </header>

      <% if (success) { %>
        <div class="banner success" role="status"><i class="ri-checkbox-circle-fill" aria-hidden="true"></i><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="banner error" role="alert"><i class="ri-error-warning-fill" aria-hidden="true"></i><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/verify-email">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label for="emailOtp">Verification code</label>
          <div class="input-wrapper">
            <i class="ri-key-2-line input-icon" aria-hidden="true"></i>
            <input id="emailOtp" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
              pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" required autofocus />
          </div>
        </div>
        <button type="submit" class="submit-btn"><span class="btn-text">Verify email</span></button>
      </form>

      <form method="POST" action="/auth/verify-email/resend" class="otp-resend-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="otp-resend-btn">Send a new code</button>
      </form>
      <p class="otp-expiry-note">The code expires in 10 minutes.</p>
    </section>
  </main>
</body>
</html>
