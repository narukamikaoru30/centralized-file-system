<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: '2FA Setup | PPO Regional FileSystem',
    description: '2FA Setup - PPO Regional FileSystem',
    cssFiles: ['/css/2fa-setup.css', '/css/system-refresh.css']
  }) %>
</head>
<body>
  <div class="particles"><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div></div>
  <div class="gradient-orb gradient-orb-1"></div>
  <div class="gradient-orb gradient-orb-2"></div>

  <div class="container">
    <div class="card">
      <div class="header">
        <div class="logo-wrapper"><i class="ri-shield-check-fill"></i></div>
        <h1>Two-Factor Setup</h1>
        <p>Add an extra layer of security to your account</p>
      </div>

      <div class="steps">
        <div class="step active"><span class="num">1</span> Scan QR</div>
        <div class="step-connector"></div>
        <div class="step active"><span class="num">2</span> Verify Code</div>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="banner success"><i class="ri-checkbox-circle-fill"></i> <%= success %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="banner error"><i class="ri-error-warning-fill"></i> <%= error %></div>
      <% } %>

      <div class="help-text">
        <p><strong>Step 1:</strong> Open your authenticator app (Google Authenticator, Authy, etc.)</p>
        <p><strong>Step 2:</strong> Scan the QR code below or manually enter the secret key</p>
        <p><strong>Step 3:</strong> Enter the 6-digit code shown in the app to verify</p>
      </div>

      <div class="qr-section">
        <img src="<%= qrDataUrl %>" alt="Scan this QR code with your authenticator app" />
      </div>

      <% if (typeof recoveryCodes !== 'undefined' && recoveryCodes && recoveryCodes.length) { %>
        <div class="recovery-box">
          <div class="recovery-header">
            <div>
              <div class="label">Recovery Codes</div>
              <small>Save these in a safe place. Each code can be used once.</small>
            </div>
            <div class="recovery-actions">
              <button type="button" class="mini-btn" data-copy-target="recoveryCodesText">Copy all</button>
              <a class="mini-btn download-btn" href="data:text/plain;charset=utf-8,<%= encodeURIComponent(recoveryCodes.join('\n')) %>" download="recovery-codes.txt">Download</a>
            </div>
          </div>
          <div id="recoveryCodesText" class="recovery-grid">
            <% recoveryCodes.forEach(function(code) { %>
              <span class="recovery-code"><%= code %></span>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="secret-key">
        <div class="label">Manual Entry Key</div>
        <div class="copy-row">
          <div class="key"><%= secret %></div>
          <button type="button" class="copy-btn" data-copy-value="<%= secret %>"><i class="ri-file-copy-line"></i> Copy</button>
        </div>
      </div>

      <form method="POST" action="/auth/2fa/setup">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label for="totpCode">Verification Code</label>
          <div class="input-wrapper">
            <i class="ri-key-line input-icon"></i>
            <input type="text" id="totpCode" name="totpCode" placeholder="000000" required
              maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" />
          </div>
        </div>
        <button type="submit" class="submit-btn"><i class="ri-shield-check-fill"></i> Enable 2FA</button>
      </form>

      <div class="cancel-link">
        <a href="<%= role === 'super_admin' ? '/auth/super' : (role === 'admin' ? '/auth/admin' : '/auth/user') %>">Cancel and go back</a>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const copyButtons = document.querySelectorAll('[data-copy-value]');
      const recoveryCopy = document.querySelector('[data-copy-target="recoveryCodesText"]');

      copyButtons.forEach(function (button) {
        button.addEventListener('click', async function () {
          const value = button.getAttribute('data-copy-value');
          try {
            await navigator.clipboard.writeText(value);
            const original = button.innerHTML;
            button.innerHTML = '<i class="ri-check-line"></i> Copied';
            setTimeout(() => { button.innerHTML = original; }, 1200);
          } catch (err) {
            button.innerHTML = '<i class="ri-alert-line"></i> Failed';
          }
        });
      });

      if (recoveryCopy) {
        recoveryCopy.addEventListener('click', async function () {
          const text = document.getElementById('recoveryCodesText')?.textContent?.trim();
          try {
            await navigator.clipboard.writeText(text || '');
            const original = recoveryCopy.textContent;
            recoveryCopy.textContent = 'Copied';
            setTimeout(() => { recoveryCopy.textContent = original; }, 1200);
          } catch (err) {
            recoveryCopy.textContent = 'Copy failed';
          }
        });
      }
    });
  </script>
</body>
</html>
