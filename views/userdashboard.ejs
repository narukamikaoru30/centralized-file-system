<script src="/js/requestHelpers.js"></script>
<script src="/js/toast.js"></script>
<script>
function escapeHtml(str) {
  if (!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
const fileInput = document.getElementById("fileInput");
const dropZone = document.getElementById("dropZone");
const fileNames = document.getElementById("fileNames");
const fileTypeSelect = document.getElementById("fileTypeSelect");
const userRole = '<%= role || "user" %>';
let currentUserName = '<%= fullname || "User" %>';
let currentUserAvatar = '<%= (typeof avatar !== "undefined" && avatar) ? avatar : "" %>';
const initialSuccessMessage = <%- JSON.stringify(success || "") %>;
const initialErrorMessage = <%- JSON.stringify(error || "") %>;
const runtimeSystemSettings = <%- JSON.stringify(systemSettings || {}) %>;
const { requestJson, postNoBody, redirectToLogin, shouldHandleTimeout } = window.RequestHelpers;
const PROFILE_PHOTO_MAX_SIZE = 2 * 1024 * 1024;
const PROFILE_PHOTO_ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
const MAX_UPLOAD_SIZE = 200 * 1024 * 1024;  // 200MB limit
let userAutoLogoutMinutes = Number(runtimeSystemSettings.autoLogoutMinutes || 30);
let userInactivityWarnTimer = null;
let userInactivityLogoutTimer = null;
let userInactivityHandler = null;
const UPLOAD_ALLOWED_MIME_BY_TYPE = {
  document: [
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    'application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'text/csv',
    'text/plain'
  ],
  image: ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'],
  report: ['application/pdf', 'text/csv', 'text/plain']
};

// Client-side AI File Categorizer
const AI_CATEGORY_RULES = {
  document: {
    mimeTypes: ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'text/plain', 'text/csv'],
    extensions: ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.txt', '.csv']
  },
  image: {
    mimeTypes: ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp', 'image/svg+xml', 'image/bmp'],
    extensions: ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp']
  },
  report: {
    mimeTypes: ['application/pdf', 'text/csv', 'text/plain'],
    extensions: ['.pdf', '.csv', '.txt'],
    namePatterns: [
      /report/i, /summary/i, /analysis/i, /statistics/i, 
      /monthly/i, /weekly/i, /daily/i, /annual/i, /quarterly/i, /semi[-_]?annual/i,
      /audit/i, /log/i, /export/i,
      /invoice/i, /receipt/i, /statement/i, /memo(randum)?/i, /minutes/i, /agenda/i,
      /budget/i, /financial/i, /expenditure/i, /disbursement/i, /procurement/i, /inventory/i, /payroll/i,
      /resolution/i, /directive/i, /circular/i, /memorandum/i, /advisory/i, /policy/i, /guideline/i,
      /case[-_]?(file|report|summary)?/i, /probation(er)?/i, /parole(e)?/i,
      /assessment/i, /evaluation/i, /compliance/i, /progress[-_]?report/i,
      /investigation/i, /surveillance/i, /supervision/i, /intake/i, /release/i,
      /commitment/i, /sentence/i, /hearing/i, /violation/i, /incident/i, /court[-_]?order/i, /legal/i,
      /accomplishment/i
    ]
  },
  letterhead: {
    patterns: [/letterhead/i, /letter[-_]?head/i, /official[-_]?(letter|doc|document)/i, /correspondence/i, /legal[-_]?size/i, /a4[-_]?size/i, /template/i]
  }
};

// Date pattern detection
const DATE_PATTERNS = [
  /\d{4}[-_]\d{2}[-_]\d{2}/,
  /\d{2}[-_]\d{2}[-_]\d{4}/,
  /(jan(uary)?|feb(ruary)?|mar(ch)?|apr(il)?|may|jun(e)?|jul(y)?|aug(ust)?|sep(t(ember)?)?|oct(ober)?|nov(ember)?|dec(ember)?)[-_]?\d{4}/i,
  /\d{4}[-_]?(jan(uary)?|feb(ruary)?|mar(ch)?|apr(il)?|may|jun(e)?|jul(y)?|aug(ust)?|sep(t(ember)?)?|oct(ober)?|nov(ember)?|dec(ember)?)/i,
  /[qQ][1-4][-_]?\d{4}|\d{4}[-_]?[qQ][1-4]/,
  /[fF][yY][-_]?\d{4}/
];

function hasDateInFilename(filename) {
  return DATE_PATTERNS.some(p => p.test(filename));
}

function isLetterhead(filename) {
  return AI_CATEGORY_RULES.letterhead.patterns.some(p => p.test(filename));
}

function clientCategorizeFile(file) {
  const ext = (file.name.lastIndexOf('.') !== -1) ? file.name.slice(file.name.lastIndexOf('.')).toLowerCase() : '';
  const mime = file.type.toLowerCase();
  const reportMimes = AI_CATEGORY_RULES.report.mimeTypes;
  const hasDate = hasDateInFilename(file.name);
  
  // Check for letterhead patterns first
  if (isLetterhead(file.name)) {
    return { category: 'document', confidence: 88, reason: 'Letterhead/official document' };
  }
  
  // Check for report patterns
  const reportRules = AI_CATEGORY_RULES.report;
  if (reportRules.namePatterns.some(p => p.test(file.name))) {
    if (reportMimes.includes(mime)) {
      const conf = hasDate ? 95 : 85;
      return { category: 'report', confidence: conf, reason: hasDate ? 'Report pattern + date' : 'Report pattern match' };
    }
  }
  
  // Date pattern with report-compatible MIME
  if (hasDate && reportMimes.includes(mime) && file.name.length > 15) {
    return { category: 'report', confidence: 80, reason: 'Date pattern + descriptive name' };
  }
  
  // Check MIME types
  for (const [cat, rules] of Object.entries(AI_CATEGORY_RULES)) {
    if (cat === 'letterhead') continue;
    if (rules.mimeTypes && rules.mimeTypes.includes(mime)) {
      return { category: cat, confidence: 90, reason: 'MIME type match' };
    }
  }
  
  // Check extensions
  for (const [cat, rules] of Object.entries(AI_CATEGORY_RULES)) {
    if (cat === 'letterhead') continue;
    if (rules.extensions && rules.extensions.includes(ext)) {
      return { category: cat, confidence: 80, reason: 'Extension match' };
    }
  }
  
  // Fallback by MIME prefix
  if (mime.startsWith('image/')) return { category: 'image', confidence: 75, reason: 'Image MIME' };
  if (mime.startsWith('text/')) return { category: 'document', confidence: 70, reason: 'Text MIME' };
  
  return { category: 'document', confidence: 50, reason: 'Default' };
}

const aiSortingEnabled = runtimeSystemSettings.aiSortingEnabled !== false;

const UPLOAD_ACCEPT_BY_TYPE = {
  document: '.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt',
  image: 'image/*',
  report: '.pdf,.csv,.txt'
};

function initUserAutoLogout(minutesInput) {
  const boundedMinutes = Math.min(120, Math.max(5, Number(minutesInput) || 30));
  userAutoLogoutMinutes = boundedMinutes;
  const timeoutBadge = document.getElementById('userTimeoutBadge');
  if (timeoutBadge) timeoutBadge.textContent = `⏱️ Session timeout: ${boundedMinutes} min`;

  const timeoutMs = boundedMinutes * 60 * 1000;
  const warningLeadMs = Math.min(60 * 1000, Math.floor(timeoutMs / 2));

  const schedule = () => {
    if (userInactivityWarnTimer) clearTimeout(userInactivityWarnTimer);
    if (userInactivityLogoutTimer) clearTimeout(userInactivityLogoutTimer);

    userInactivityWarnTimer = setTimeout(() => {
      const warnMinutes = warningLeadMs >= 60000
        ? `${Math.max(1, Math.round(warningLeadMs / 60000))} minute(s)`
        : `${Math.max(5, Math.round(warningLeadMs / 1000))} second(s)`;
      showFeedbackToast(`⚠️ Session expires in ${warnMinutes} due to inactivity.`, 'error');
    }, Math.max(1000, timeoutMs - warningLeadMs));

    userInactivityLogoutTimer = setTimeout(() => {
      window.location.href = '/auth/logout';
    }, timeoutMs);
  };

  if (userInactivityHandler) {
    ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
      document.removeEventListener(evt, userInactivityHandler);
    });
  }

  userInactivityHandler = () => schedule();
  ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
    document.addEventListener(evt, userInactivityHandler, { passive: true });
  });

  // 🔐 Fix #19: Pause inactivity timer when page is not visible (background tab)
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      // Page hidden - pause logout timers
      if (userInactivityWarnTimer) clearTimeout(userInactivityWarnTimer);
      if (userInactivityLogoutTimer) clearTimeout(userInactivityLogoutTimer);
    } else {
      // Page visible again - reschedule timers
      schedule();
    }
  });

  schedule();
}

function formatBytes(bytes) {
  if (!bytes || bytes < 1024) return `${bytes || 0} B`;
  const units = ['KB', 'MB', 'GB'];
  let value = bytes / 1024;
  let unitIndex = 0;
  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024;
    unitIndex += 1;
  }
  return `${value.toFixed(1)} ${units[unitIndex]}`;
}

function updateFileInputAccept() {
  if (!fileInput || !fileTypeSelect) return;
  const selectedType = fileTypeSelect.value || 'document';
  fileInput.setAttribute('accept', UPLOAD_ACCEPT_BY_TYPE[selectedType] || '.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,image/*');
}

function getAvatarUrl(avatarFilename) {
  return avatarFilename ? `/uploads/${avatarFilename}` : 'https://via.placeholder.com/50';
}

function openProfileModal() {
  const modal = document.getElementById('profileModal');
  if (!modal) return;
  const total = document.getElementById('statTotal')?.textContent || '0';
  const roleText = userRole === 'super_admin' ? 'super_admin' : (userRole === 'admin' ? 'admin' : 'user');
  const profileFiles = document.getElementById('profileFiles');
  const profileRole = document.getElementById('profileRole');
  const profileName = document.getElementById('profileName');
  const profileNameInput = document.getElementById('profileFullnameInput');
  const avatar = document.getElementById('avatar');
  const profileAvatar = document.getElementById('profileAvatar');
  const profileStatus = document.getElementById('profileStatus');
  if (profileFiles) profileFiles.textContent = total;
  if (profileRole) profileRole.textContent = roleText;
  if (profileName) profileName.textContent = currentUserName;
  if (profileNameInput) profileNameInput.value = currentUserName;
  if (avatar) avatar.src = getAvatarUrl(currentUserAvatar);
  if (profileAvatar) profileAvatar.src = getAvatarUrl(currentUserAvatar);
  if (profileStatus) {
    profileStatus.textContent = '';
    profileStatus.className = 'profile-status';
  }
  modal.classList.add('show');
}

function closeProfileModal() {
  const modal = document.getElementById('profileModal');
  if (!modal) return;
  modal.classList.remove('show');
}

function getExtensionCategory(filename) {
  const ext = (filename || '').toLowerCase().split('.').pop();
  if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'].includes(ext)) return 'image';
  if (ext === 'pdf') return 'pdf';
  if (ext === 'docx' || ext === 'doc') return 'docx';
  if (['xls', 'xlsx', 'csv'].includes(ext)) return 'excel';
  return 'other';
}

function getCategoryLabel(category) {
  if (category === 'pdf') return 'PDF';
  if (category === 'docx') return 'DOCX';
  if (category === 'excel') return 'EXCEL';
  if (category === 'image') return 'IMAGE';
  return 'OTHER';
}

// Initialize dashboard
document.addEventListener('DOMContentLoaded', function() {
  // Update header with user info
  const headerTitle = document.querySelector('.user-info h1');
  if (headerTitle) headerTitle.textContent = `Welcome, ${currentUserName}`;
  const avatar = document.getElementById('avatar');
  if (avatar) avatar.src = getAvatarUrl(currentUserAvatar);
  if (initialSuccessMessage) showFeedbackToast(initialSuccessMessage, 'success');
  else if (initialErrorMessage) showFeedbackToast(initialErrorMessage, 'error');
  initUserAutoLogout(userAutoLogoutMinutes);
  
  // Populate files from passed data
  const filesData = <%- JSON.stringify(files || []) %>;
  const totalFiles = filesData.length;
  const totalDocs = filesData.filter(file => file.filetype === 'document' || file.filetype === 'pdf').length;
  const totalImages = filesData.filter(file => file.filetype === 'image').length;

  const statTotal = document.getElementById('statTotal');
  const statDocs = document.getElementById('statDocs');
  const statImages = document.getElementById('statImages');
  if (statTotal) statTotal.textContent = totalFiles;
  if (statDocs) statDocs.textContent = totalDocs;
  if (statImages) statImages.textContent = totalImages;

  // Server already renders filesContainer via EJS — do NOT overwrite innerHTML here
  // (preserves checkboxes, version badges, shared badges, tags)

  // Sidebar active state
  document.querySelectorAll('.sidebar ul li a').forEach(link => {
    link.addEventListener('click', function(e) {
      document.querySelectorAll('.sidebar ul li a').forEach(l => l.classList.remove('active'));
      this.classList.add('active');
    });
  });

  if (avatar) {
    avatar.addEventListener('click', openProfileModal);
  }

  const profileEditForm = document.getElementById('profileEditForm');
  if (profileEditForm) {
    profileEditForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const profileSaveBtn = document.getElementById('profileSaveBtn');
      const profileStatus = document.getElementById('profileStatus');
      const profileNameInput = document.getElementById('profileFullnameInput');
      const profilePhotoInput = document.getElementById('profilePhotoInput');

      const fullname = (profileNameInput?.value || '').trim();
      if (!fullname) {
        if (profileStatus) {
          profileStatus.textContent = 'Please enter your full name.';
          profileStatus.className = 'profile-status error';
        }
        return;
      }

      if (fullname.length > 80) {
        if (profileStatus) {
          profileStatus.textContent = 'Full name must be 80 characters or fewer.';
          profileStatus.className = 'profile-status error';
        }
        return;
      }

      const selectedPhoto = profilePhotoInput?.files?.[0];
      if (selectedPhoto) {
        // Validate file extension matches MIME type (prevent .exe renamed to .jpg)
        const ext = selectedPhoto.name.toLowerCase().split('.').pop();
        const ALLOWED_EXTS = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
        if (!ALLOWED_EXTS.includes(ext)) {
          if (profileStatus) {
            profileStatus.textContent = 'Invalid file extension. Allowed: JPG, PNG, GIF, WEBP';
            profileStatus.className = 'profile-status error';
          }
          return;
        }
        
        if (!PROFILE_PHOTO_ALLOWED_TYPES.includes(selectedPhoto.type)) {
          if (profileStatus) {
            profileStatus.textContent = 'Only JPG, PNG, GIF, or WEBP images are allowed.';
            profileStatus.className = 'profile-status error';
          }
          return;
        }

        if (selectedPhoto.size > PROFILE_PHOTO_MAX_SIZE) {
          if (profileStatus) {
            profileStatus.textContent = 'Profile photo must be 2MB or smaller.';
            profileStatus.className = 'profile-status error';
          }
          return;
        }
      }

      const formData = new FormData();
      formData.append('fullname', fullname);
      if (selectedPhoto) {
        formData.append('profilePhoto', selectedPhoto);
      }

      if (profileSaveBtn) profileSaveBtn.disabled = true;
      if (profileStatus) {
        profileStatus.textContent = 'Saving profile...';
        profileStatus.className = 'profile-status';
      }

      try {
        const data = await requestJson('/auth/user/profile', {
          method: 'POST',
          body: formData
        });

        if (!data.success) {
          throw new Error(data.message || 'Unable to update profile');
        }

        currentUserName = data.fullname || currentUserName;
        currentUserAvatar = data.avatar || currentUserAvatar;

        const profileName = document.getElementById('profileName');
        const headerTitle = document.querySelector('.user-info h1');
        const headerAvatar = document.getElementById('avatar');
        const profileAvatar = document.getElementById('profileAvatar');

        if (profileName) profileName.textContent = currentUserName;
        if (headerTitle) headerTitle.textContent = `Welcome, ${currentUserName}`;
        if (headerAvatar) headerAvatar.src = getAvatarUrl(currentUserAvatar);
        if (profileAvatar) profileAvatar.src = getAvatarUrl(currentUserAvatar);

        if (profilePhotoInput) profilePhotoInput.value = '';
        if (profileStatus) {
          profileStatus.textContent = 'Profile updated successfully.';
          profileStatus.className = 'profile-status success';
          setTimeout(() => closeProfileModal(), 1500);
        }
      } catch (err) {
        if (profileStatus) {
          profileStatus.textContent = err.message || 'Unable to update profile';
          profileStatus.className = 'profile-status error';
        }
      } finally {
        if (profileSaveBtn) profileSaveBtn.disabled = false;
      }
    });
  }

  // --- 2FA Disable Handler with Secure Modal ---
  const disable2faBtn = document.getElementById('disable2faBtn');
  if (disable2faBtn) {
    disable2faBtn.addEventListener('click', function() {
      // Show secure password modal instead of prompt()
      openActionConfirm(
        '🔐 Disable 2FA',
        'Enter your password to disable two-factor authentication.',
        'Disable',
        'danger',
        null
      );
      
      // Replace modal content with password input
      const modal = document.getElementById('actionConfirmModal');
      const messageEl = document.getElementById('confirmMessage');
      if (modal && messageEl) {
        messageEl.innerHTML = `
          <div style="text-align:left;margin:1rem 0;">
            <label style="display:block;margin-bottom:0.5rem;font-weight:600;color:#111827;">Password</label>
            <input type="password" id="disable2faPasswordInput" placeholder="Enter your password" 
                   style="width:100%;padding:0.75rem;border:1px solid #d1d5db;border-radius:8px;font-size:1rem;box-sizing:border-box;" 
                   autocomplete="current-password" />
          </div>
        `;
        
        const okBtn = document.getElementById('confirmOkBtn');
        if (okBtn) {
          okBtn.onclick = async function() {
            const passwordInput = document.getElementById('disable2faPasswordInput');
            const password = passwordInput?.value || '';
            if (!password) {
              showFeedbackToast('❌ Please enter your password', 'error');
              return;
            }
            
            closeActionConfirm();
            const statusEl = document.getElementById('twoFaStatus');
            disable2faBtn.disabled = true;
            if (statusEl) { statusEl.textContent = 'Disabling...'; statusEl.style.color = '#666'; }
            
            try {
              const res = await fetch('/auth/2fa/disable', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.RequestHelpers.getCsrfToken() || '' },
                body: JSON.stringify({ password }),
                credentials: 'same-origin'
              });
              const data = await res.json();
              if (data.success) {
                if (statusEl) { statusEl.textContent = '2FA disabled successfully. Reloading...'; statusEl.style.color = '#22c55e'; }
                setTimeout(() => location.reload(), 1200);
              } else {
                if (statusEl) { statusEl.textContent = data.message || 'Failed to disable 2FA'; statusEl.style.color = '#ef4444'; }
                disable2faBtn.disabled = false;
              }
            } catch (err) {
              if (statusEl) { statusEl.textContent = 'Error disabling 2FA'; statusEl.style.color = '#ef4444'; }
              disable2faBtn.disabled = false;
            }
          };
        }
      }
    });
  }
});

