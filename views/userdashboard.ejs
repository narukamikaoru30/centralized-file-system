function displayFileNames(files) {
  fileNames.innerHTML = "";
  const aiResults = document.getElementById("aiDetectionResults");
  const aiList = document.getElementById("aiDetectionList");
  
  if (!files || files.length === 0) {
    if (aiResults) aiResults.style.display = "none";
    return;
  }
  
  const detections = [];
  
  Array.from(files).forEach(file => {
    const div = document.createElement("div");
    div.textContent = `📄 ${file.name} (${formatBytes(file.size)})`;
    fileNames.appendChild(div);
    
    // AI Detection
    if (aiSortingEnabled) {
      const detection = clientCategorizeFile(file);
      detections.push({ name: file.name, ...detection });
    }
  });
  
  // Show AI detection results
  if (aiSortingEnabled && detections.length > 0 && aiResults && aiList) {
    aiList.innerHTML = "";
    detections.forEach(d => {
      const item = document.createElement("div");
      item.className = "ai-detection-item";
      const icon = d.category === 'image' ? '🖼️' : d.category === 'report' ? '📊' : '📄';
      item.innerHTML = `
        <span class="file-name" title="${d.name}">${d.name.length > 20 ? d.name.substring(0, 17) + '...' : d.name}</span>
        <span class="detected-type">${icon} ${d.category}</span>
        <span class="confidence" title="${d.reason || ''}">${d.confidence}%</span>
      `;
      aiList.appendChild(item);
    });
    aiResults.style.display = "block";
    
    // Auto-select category if all files are the same type
    const uniqueCategories = [...new Set(detections.map(d => d.category))];
    if (uniqueCategories.length === 1 && fileTypeSelect) {
      const detected = uniqueCategories[0];
      // If there's an auto-detect option, keep it selected but show detection
      // Otherwise auto-select the detected category
      const hasAutoOption = fileTypeSelect.querySelector('option[value=""]');
      if (!hasAutoOption) {
        fileTypeSelect.value = detected;
      }
    }
  } else if (aiResults) {
    aiResults.style.display = "none";
  }
}

// Upload with progress + modal + real database (supports multiple files)
document.getElementById("uploadForm").addEventListener("submit", async function(e) {
  e.preventDefault();
  const uploadForm = this;
  const uploadBtn = uploadForm.querySelector('button[type="submit"]');
  const progressBar = document.getElementById("progressBar");
  const progressFill = document.getElementById("progressFill");
  const modal = document.getElementById("feedbackModal");
  const feedbackBox = document.getElementById("feedbackBox");
  const feedbackMessage = document.getElementById("feedbackMessage");
  let selectedType = fileTypeSelect?.value || '';
  const files = Array.from(fileInput.files);
  
  // If AI sorting is enabled and no category selected, auto-detect
  if (aiSortingEnabled && !selectedType && files.length > 0) {
    const detections = files.map(f => clientCategorizeFile(f));
    const uniqueCategories = [...new Set(detections.map(d => d.category))];
    selectedType = uniqueCategories.length === 1 ? uniqueCategories[0] : detections[0].category;
    console.log('[AI Upload] Auto-detected category:', selectedType);
  }
  
  // Default fallback
  if (!selectedType) selectedType = 'document';

  if (!files.length) {
    feedbackMessage.textContent = "❌ Please select at least one file";
    feedbackBox.className = "modal-content error";
    modal.classList.add("show");
    setTimeout(() => { modal.classList.remove("show"); }, 3000);
    return;
  }

  if (files.length > 10) {
    feedbackMessage.textContent = "❌ Maximum 10 files per upload";
    feedbackBox.className = "modal-content error";
    modal.classList.add("show");
    setTimeout(() => { modal.classList.remove("show"); }, 3000);
    return;
  }

  const allowedMimes = UPLOAD_ALLOWED_MIME_BY_TYPE[selectedType] || [];
  const invalidFiles = [];
  for (const file of files) {
    if (file.size > MAX_UPLOAD_SIZE) {
      feedbackMessage.textContent = `❌ "${file.name}" exceeds 15MB limit`;
      feedbackBox.className = "modal-content error";
      modal.classList.add("show");
      setTimeout(() => { modal.classList.remove("show"); }, 3000);
      return;
    }
    // For batch uploads: collect invalid files but allow submission
    if (allowedMimes.length && !allowedMimes.includes(file.type)) {
      invalidFiles.push(file.name);
    }
  }
  
  // If some files are invalid in a batch, warn but continue
  if (invalidFiles.length > 0 && invalidFiles.length < files.length) {
    console.warn(`⚠️ Warning: ${invalidFiles.length} file(s) may not match category "${selectedType}": ${invalidFiles.join(', ')}`);
    // Continue with upload - server will handle
  } else if (invalidFiles.length === files.length) {
    // ALL files are invalid - reject
    feedbackMessage.textContent = `❌ No files match category "${selectedType}"`;
    feedbackBox.className = "modal-content error";
    modal.classList.add("show");
    setTimeout(() => { modal.classList.remove("show"); }, 3000);
    return;
  }

  if (uploadBtn) uploadBtn.disabled = true;
  progressBar.style.display = "block";
  progressFill.style.width = "0%";

  const formData = new FormData();
  files.forEach(file => formData.append('files', file));
  formData.append('filetype', selectedType);
  
  // Add tags if provided
  const tagsInput = document.getElementById('uploadTags');
  if (tagsInput && tagsInput.value.trim()) {
    formData.append('tags', tagsInput.value.trim());
  }

  // 🔐 ALWAYS refresh CSRF token before upload to ensure cookie is set
  let csrfToken = '';
  try {
    const tokenResponse = await fetch('/csrf-token', { 
      method: 'GET', 
      credentials: 'same-origin'
    });
    if (tokenResponse.ok) {
      const tokenData = await tokenResponse.json();
      csrfToken = tokenData.csrfToken || '';
      if (!csrfToken) {
        throw new Error('No token in response');
      }
    } else {
      throw new Error(`Token endpoint returned ${tokenResponse.status}`);
    }
  } catch (err) {
    progressBar.style.display = "none";
    progressFill.style.width = "0%";
    feedbackMessage.textContent = `❌ Failed to get CSRF token: ${err.message}`;
    feedbackBox.className = "modal-content error";
    modal.classList.add("show");
    setTimeout(() => { modal.classList.remove("show"); }, 3000);
    if (uploadBtn) uploadBtn.disabled = false;
    return;
  }

  const request = new XMLHttpRequest();
  request.open('POST', '/auth/upload');
  request.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
  request.setRequestHeader('Accept', 'application/json');
  request.setRequestHeader('X-CSRF-Token', csrfToken);
  request.upload.addEventListener('progress', function(evt) {
    if (!evt.lengthComputable) return;
    const progress = Math.min(100, Math.round((evt.loaded / evt.total) * 100));
    progressFill.style.width = `${progress}%`;
  });

  request.onreadystatechange = function() {
    if (request.readyState !== XMLHttpRequest.DONE) return;

    let payload = null;
    try {
      payload = request.responseText ? JSON.parse(request.responseText) : null;
    } catch (_) {
      payload = null;
    }

    if (shouldHandleTimeout(request.status, payload)) {
      redirectToLogin(payload && payload.redirect);
      return;
    }

    if (request.status >= 200 && request.status < 300 && payload && payload.success) {
      progressFill.style.width = "100%";
      const uploadedCount = payload.uploadedCount || files.length;
      feedbackMessage.textContent = `✅ ${payload.message || (uploadedCount > 1 ? uploadedCount + ' files uploaded successfully!' : 'File uploaded successfully!')}`;
      feedbackBox.className = "modal-content success";
      modal.classList.add("show");

      setTimeout(() => {
        modal.classList.remove("show");
        progressBar.style.display = "none";
        progressFill.style.width = "0%";
        fileNames.innerHTML = "";
        if (fileInput) fileInput.value = '';
        const tagsInput = document.getElementById('uploadTags');
        if (tagsInput) tagsInput.value = '';
        location.reload();
      }, 1200);
      return;
    }

    progressBar.style.display = "none";
    progressFill.style.width = "0%";
    // Suppress error feedback - user can see file status after reload
    // No error banner shown on failure
  };

  request.onerror = function() {
    progressBar.style.display = "none";
    progressFill.style.width = "0%";
    feedbackMessage.textContent = "❌ Network error: Upload failed. Please check your connection and try again.";
    feedbackBox.className = "modal-content error";
    modal.classList.add("show");
    setTimeout(() => { modal.classList.remove("show"); }, 5000);
    if (uploadBtn) uploadBtn.disabled = false;
  };

  request.onloadend = function() {
    if (uploadBtn) uploadBtn.disabled = false;
  };

  request.send(formData);
});
</script>



