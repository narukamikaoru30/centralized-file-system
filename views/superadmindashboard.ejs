                existingAdminRow.remove();
              }

              reindexTableRows('adminTable');
              ensureBaseEmptyRow('adminTable', 5, 'No admin accounts available to manage.');
              applyCurrentBranchFilters();
            }
            refreshSuperStats();
          } else {
            showActionToast(data.message, 'error');
          }
        })
        .catch(err => showActionToast(err.message || 'Role update failed', 'error'));
      }
    }

