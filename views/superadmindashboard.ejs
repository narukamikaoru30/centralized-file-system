<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Super Admin Dashboard | PPO Regional FileSystem',
    description: 'Super Admin Dashboard - PPO Regional FileSystem',
    cssFiles: ['/css/dashboard.css', '/css/super-dashboard.css', '/css/system-refresh.css']
  }) %>
</head>

<body>

  <div class="dashboard-container">

    <%- include('partials/sidebar', {
      title: 'Super Admin',
      sidebarIcon: 'shield-star-line',
      items: [
        { href: '#overview', label: 'Dashboard', icon: 'bar-chart-box-line', active: true },
        { href: '#settings', label: 'System Settings', icon: 'settings-3-line' },
        { href: '#branches', label: 'Branch Admins', icon: 'building-line' },
        { href: '#admins', label: 'Manage Admins', icon: 'group-line' },
        { href: '#users', label: 'Manage Users', icon: 'user-line' },
        { href: '#files', label: 'Global Files', icon: 'folder-3-line' },
        { href: '#audit', label: 'Audit Logs', icon: 'file-list-3-line' }
      ]
    }) %>

    <!-- Main Content -->
    <main class="main-content">

      <!-- Header -->
      <header class="dashboard-header">
        <div class="user-info">
          <img id="superAvatar" src="<%= (typeof avatar !== 'undefined' && avatar) ? ('/uploads/' + avatar) : 'https://via.placeholder.com/60' %>" class="avatar" alt="Avatar">
          <div>
            <h1 id="superWelcomeName">Welcome, <%= fullname || "Super Admin" %></h1>
            <p>
              PPO Regional FileSystem — Full Control
              <span id="superTimeoutBadge" class="session-timeout-badge"><i class="ri-timer-line"></i> Session timeout: <%= (systemSettings && systemSettings.autoLogoutMinutes) ? systemSettings.autoLogoutMinutes : 30 %> min</span>
            </p>
          </div>
        </div>
      </header>

      <!-- Overview -->
      <section class="overview" id="overview">
        <h2><i class="ri-bar-chart-box-line"></i> System Overview</h2>
        <div class="stats-grid">
          <div class="stat-card">
            <i class="ri-file-list-3-line stat-icon"></i>
            <h3>Total Files</h3>
            <p id="totalFiles">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-group-line stat-icon"></i>
            <h3>Total Users</h3>
            <p id="totalUsers">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-shield-user-line stat-icon"></i>
            <h3>Total Admins</h3>
            <p id="totalAdmins">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-settings-3-line stat-icon"></i>
            <h3>System Actions</h3>
            <p id="systemActions">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-admin-line stat-icon"></i>
            <h3>Active Admin Accounts</h3>
            <p id="activeAdminAccounts">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-user-heart-line stat-icon"></i>
            <h3>Active User Accounts</h3>
            <p id="activeUserAccounts">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-line-chart-line stat-icon"></i>
            <h3>Next Month Forecast</h3>
            <p id="predictedUploads">0</p>
            <span id="predictedUploadsLabel" class="stat-caption">Next month</span>
          </div>
        </div>
      </section>

      <!-- System Settings -->
      <section class="system-settings" id="settings">
        <h2><i class="ri-settings-3-line section-icon"></i> System Settings</h2>
        <form id="settingsForm">
          <label>
            <input type="checkbox" id="notifCheck" <%= (systemSettings && systemSettings.notificationsEnabled !== false) ? 'checked' : '' %>>
            Enable Notifications
          </label>
          <label>
            <input type="checkbox" id="aiSortCheck" <%= (systemSettings && systemSettings.aiSortingEnabled !== false) ? 'checked' : '' %>>
            Enable AI File Sorting
          </label>
          <label>
            Auto-Logout (minutes):
            <input type="number" id="logoutTime" value="<%= (systemSettings && systemSettings.autoLogoutMinutes) ? systemSettings.autoLogoutMinutes : 30 %>" min="5" max="120">
          </label>
          <button type="submit"><i class="ri-save-line"></i> Save Settings</button>
        </form>
      </section>

      <section class="branch-assignments" id="branches">
        <h2><i class="ri-building-line section-icon"></i> Branch Admin Assignments</h2>
        <div class="branch-list">
          <% (branchAdminAssignments || []).forEach(function(item) { %>
            <div class="branch-item">
              <div class="branch-name"><%= item.branch %></div>
              <% if (item.adminEmail) { %>
                <span class="branch-badge occupied">Occupied by: <%= item.adminEmail %></span>
              <% } else { %>
                <span class="branch-badge available">Available</span>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="activity-panel-section" id="activity">
        <h2><i class="ri-notification-3-line section-icon"></i> Recent Activity</h2>
        <div class="activity-panel">
          <% if ((recentNotifications || []).length) { %>
            <% recentNotifications.forEach(function(note) { %>
              <div class="activity-item">
                <div class="activity-icon"><%= note.icon || '🔔' %></div>
                <div class="activity-body">
                  <strong><%= note.message %></strong>
                  <div class="activity-meta"><%= new Date(note.date).toLocaleString() %></div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="activity-empty">No file activity yet.</div>
          <% } %>
        </div>
      </section>

      <!-- Manage Admins -->
      <section class="manage-admins" id="admins">
        <h2><i class="ri-group-line section-icon"></i> Manage Admin Accounts</h2>
        <div class="table-toolbar">
          <label for="adminBranchFilter">Filter by Branch:
            <select id="adminBranchFilter">
              <option value="">All Branches</option>
            </select>
          </label>
        </div>
        <div class="table-wrapper super-table-wrap">
        <table class="super-table">
              <thead>
                <tr>
                  <th class="sortable" onclick="sortTable(0, 'adminTable')">Admin ID</th>
                  <th class="sortable" onclick="sortTable(1, 'adminTable')">Email</th>
                  <th class="sortable" onclick="sortTable(2, 'adminTable')">Branch</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="adminTable">
              </tbody>
              </table>
              </div>
      </section>

      <!-- Manage Users -->
      <section class="manage-users" id="users">
        <h2><i class="ri-user-line section-icon"></i> Manage User Accounts</h2>
        <div class="table-toolbar">
          <label for="userBranchFilter">Filter by Branch:
            <select id="userBranchFilter">
              <option value="">All Branches</option>
            </select>
          </label>
        </div>
        <div class="table-wrapper super-table-wrap">
        <table class="super-table">
              <thead>
                <tr>
                  <th class="sortable" onclick="sortTable(0, 'superUserTable')">User ID</th>
                  <th class="sortable" onclick="sortTable(1, 'superUserTable')">Email</th>
                  <th>Role</th>
                  <th class="sortable" onclick="sortTable(3, 'superUserTable')">Branch</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="superUserTable">
              </tbody>
              </table>
              </div>
      </section>

      <!-- Global Files -->
      <section class="global-files" id="files">
        <h2><i class="ri-folder-3-line section-icon"></i> Global File Oversight</h2>
        <div class="table-wrapper super-table-wrap">
        <table class="super-table">
          <colgroup>
            <col style="width:25%">
            <col style="width:10%">
            <col style="width:20%">
            <col style="width:15%">
            <col style="width:10%">
            <col style="width:20%">
          </colgroup>
              <thead>
                <tr>
                  <th class="sortable" onclick="sortTable(0, 'fileTable')">File Name</th>
                  <th class="sortable" onclick="sortTable(1, 'fileTable')">Category</th>
                  <th class="sortable" onclick="sortTable(2, 'fileTable')">Uploaded By</th>
                  <th class="sortable" onclick="sortTable(3, 'fileTable')">Branch</th>
                  <th class="sortable" onclick="sortTable(4, 'fileTable')">Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="fileTable">
              </tbody>
              </table>
              </div>
      </section>

      <!-- Audit Logs -->
      <section class="audit-logs" id="audit">
        <h2><i class="ri-file-list-3-line section-icon"></i> Audit Logs</h2>
        <ul id="auditList">
        </ul>
      </section>

    </main>
  </div>

  <div id="superProfileModal" class="profile-modal" role="dialog" aria-modal="true" aria-label="Super Admin Profile" onclick="if(event.target===this) closeSuperProfileModal()">
    <div class="profile-card">
      <div class="profile-head">
        <div>
          <h3>Super Admin Profile</h3>
          <p>Update your account details</p>
        </div>
        <button class="profile-close" type="button" onclick="closeSuperProfileModal()" aria-label="Close profile"><i class="ri-close-line"></i></button>
      </div>
      <div class="profile-body">
        <div class="profile-user">
          <img id="superProfileAvatar" src="<%= (typeof avatar !== 'undefined' && avatar) ? ('/uploads/' + avatar) : 'https://via.placeholder.com/60' %>" class="profile-avatar" alt="Super Admin Avatar" />
          <div>
            <h4 id="superProfileName"><%= fullname || 'Super Admin' %></h4>
            <p><%= email %></p>
          </div>
        </div>
        <div class="profile-list">
          <div class="profile-row"><span>Role</span><strong><%= role || 'super_admin' %></strong></div>
          <div class="profile-row"><span>Status</span><strong>Active</strong></div>
          <div class="profile-row"><span>Access</span><strong>Full</strong></div>
        </div>
        <form id="superProfileForm" class="profile-form" enctype="multipart/form-data">
          <div class="profile-field">
            <label for="superFullnameInput">Full Name</label>
            <input id="superFullnameInput" type="text" value="<%= fullname || '' %>" required />
          </div>
          <div class="profile-field">
            <label for="superPhotoInput">Profile Photo</label>
            <input id="superPhotoInput" type="file" accept="image/*" />
          </div>
          <button id="superProfileSaveBtn" class="profile-save-btn" type="submit">Save Changes</button>
        </form>
        <div id="superProfileStatus" class="profile-status"></div>
      </div>
    </div>
  </div>

  <div id="actionConfirmModal" class="action-modal" onclick="if(event.target===this) closeActionConfirm(false)">
    <div class="action-modal-card" role="dialog" aria-modal="true" aria-labelledby="actionConfirmTitle">
      <div class="action-modal-head">
        <h3 id="actionConfirmTitle">Confirm Action</h3>
      </div>
      <p id="actionConfirmMessage" class="action-modal-message">Are you sure you want to continue?</p>
      <div id="actionConfirmField" class="action-modal-field" style="display:none;">
        <label id="actionConfirmInputLabel" for="actionConfirmInput">New Password</label>
        <input id="actionConfirmInput" class="action-modal-input" type="password" autocomplete="new-password" />
        <div id="actionConfirmInputError" class="action-modal-error"></div>
      </div>
      <div class="action-modal-actions">
        <button id="actionConfirmCancel" type="button" class="confirm-btn cancel" onclick="closeActionConfirm(false)">Cancel</button>
        <button id="actionConfirmOkBtn" type="button" class="confirm-btn danger">Confirm</button>
      </div>
    </div>
  </div>

  <div id="actionToast" class="action-toast" aria-live="polite"></div>

  <!-- JS (enhanced logic) -->
  <script src="/js/requestHelpers.js"></script>
  <script src="/js/toast.js"></script>
  <script>
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    let superDisplayName = '<%= fullname || "Super Admin" %>';
    let superAvatarFile = '<%= (typeof avatar !== "undefined" && avatar) ? avatar : "" %>';
    const initialSuccessMessage = <%- JSON.stringify(success || "") %>;
    const initialErrorMessage = <%- JSON.stringify(error || "") %>;
    const runtimeSystemSettings = <%- JSON.stringify(systemSettings || {}) %>;
    const PROFILE_PHOTO_MAX_SIZE = 2 * 1024 * 1024;
    const PROFILE_PHOTO_ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    let autoLogoutMinutes = Number(runtimeSystemSettings.autoLogoutMinutes || 30);
    let inactivityWarnTimer = null;
    let inactivityLogoutTimer = null;
    let inactivityWarningShown = false;
    let inactivityActivityHandler = null;

    function initSuperAutoLogout(minutesInput) {
      const boundedMinutes = Math.min(120, Math.max(5, Number(minutesInput) || 30));
      autoLogoutMinutes = boundedMinutes;
      const timeoutBadge = document.getElementById('superTimeoutBadge');
      if (timeoutBadge) timeoutBadge.textContent = `Session timeout: ${boundedMinutes} min`;

      const timeoutMs = boundedMinutes * 60 * 1000;
      const warningLeadMs = Math.min(60 * 1000, Math.floor(timeoutMs / 2));

      const schedule = () => {
        if (inactivityWarnTimer) clearTimeout(inactivityWarnTimer);
        if (inactivityLogoutTimer) clearTimeout(inactivityLogoutTimer);
        inactivityWarningShown = false;

        inactivityWarnTimer = setTimeout(() => {
          if (!inactivityWarningShown) {
            inactivityWarningShown = true;
            const warnMinutes = warningLeadMs >= 60000
              ? `${Math.max(1, Math.round(warningLeadMs / 60000))} minute(s)`
              : `${Math.max(5, Math.round(warningLeadMs / 1000))} second(s)`;
            showActionToast(`Session expires in ${warnMinutes} due to inactivity.`, 'error');
          }
        }, Math.max(1000, timeoutMs - warningLeadMs));

        inactivityLogoutTimer = setTimeout(() => {
          window.location.href = '/auth/logout';
        }, timeoutMs);
      };

      if (inactivityActivityHandler) {
        ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
          document.removeEventListener(evt, inactivityActivityHandler);
        });
      }

      const resetOnActivity = () => schedule();
      inactivityActivityHandler = resetOnActivity;
      ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
        document.addEventListener(evt, inactivityActivityHandler, { passive: true });
      });

      schedule();
    }

    function getSuperAvatarUrl(avatarFilename) {
      return avatarFilename ? `/uploads/${avatarFilename}` : 'https://via.placeholder.com/60';
    }

    function openSuperProfileModal() {
      const modal = document.getElementById('superProfileModal');
      const headerAvatar = document.getElementById('superAvatar');
      const profileAvatar = document.getElementById('superProfileAvatar');
      const profileName = document.getElementById('superProfileName');
      const fullnameInput = document.getElementById('superFullnameInput');
      const statusEl = document.getElementById('superProfileStatus');
      if (headerAvatar) headerAvatar.src = getSuperAvatarUrl(superAvatarFile);
      if (profileAvatar) profileAvatar.src = getSuperAvatarUrl(superAvatarFile);
      if (profileName) profileName.textContent = superDisplayName;
      if (fullnameInput) fullnameInput.value = superDisplayName;
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.className = 'profile-status';
      }
      if (modal) modal.classList.add('show');
    }

    function closeSuperProfileModal() {
      const modal = document.getElementById('superProfileModal');
      if (modal) modal.classList.remove('show');
    }

    let actionConfirmResolver = null;
    let actionToastTimer = null;

    function showActionToast(message, type = 'info') {
      const toast = document.getElementById('actionToast');
      if (!toast) return;
      toast.textContent = message;
      toast.className = `action-toast ${type}`;
      requestAnimationFrame(() => toast.classList.add('show'));
      if (actionToastTimer) clearTimeout(actionToastTimer);
      actionToastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function closeActionConfirm(result) {
      const modal = document.getElementById('actionConfirmModal');
      const input = document.getElementById('actionConfirmInput');
      const inputError = document.getElementById('actionConfirmInputError');
      const inputField = document.getElementById('actionConfirmField');
      if (modal) modal.classList.remove('show');
      if (input) input.value = '';
      if (inputError) inputError.textContent = '';
      if (inputField) inputField.style.display = 'none';
      if (actionConfirmResolver) {
        const resolve = actionConfirmResolver;
        actionConfirmResolver = null;
        resolve(result);
      }
    }

    function showActionConfirm({ title = 'Confirm Action', message = 'Are you sure?', confirmText = 'Confirm', cancelText = 'Cancel', danger = false, input = null }) {
      const modal = document.getElementById('actionConfirmModal');
      const titleEl = document.getElementById('actionConfirmTitle');
      const msgEl = document.getElementById('actionConfirmMessage');
      const okBtn = document.getElementById('actionConfirmOkBtn');
      const cancelBtn = document.getElementById('actionConfirmCancel');
      const inputField = document.getElementById('actionConfirmField');
      const inputLabelEl = document.getElementById('actionConfirmInputLabel');
      const inputEl = document.getElementById('actionConfirmInput');
      const inputErrorEl = document.getElementById('actionConfirmInputError');

      if (titleEl) titleEl.textContent = title;
      if (msgEl) msgEl.textContent = message;
      if (inputField) inputField.style.display = input ? 'grid' : 'none';
      if (inputLabelEl && input?.label) inputLabelEl.textContent = input.label;
      if (inputEl) {
        inputEl.type = input?.type || 'password';
        inputEl.placeholder = input?.placeholder || '';
        inputEl.value = '';
      }
      if (inputErrorEl) inputErrorEl.textContent = '';

      if (okBtn) {
        okBtn.textContent = confirmText;
        okBtn.className = `confirm-btn ${danger ? 'danger' : 'primary'}`;
        okBtn.onclick = () => {
          if (!input) {
            closeActionConfirm(true);
            return;
          }

          const inputValue = (inputEl?.value || '').trim();
          const minLength = Number(input.minLength || 1);
          if (inputValue.length < minLength) {
            if (inputErrorEl) inputErrorEl.textContent = `${input.label || 'Value'} must be at least ${minLength} characters.`;
            return;
          }

          closeActionConfirm({ confirmed: true, value: inputValue });
        };
      }
      if (cancelBtn) cancelBtn.textContent = cancelText;
      if (modal) modal.classList.add('show');

      if (input && inputEl) {
        setTimeout(() => inputEl.focus(), 0);
      }

      return new Promise(resolve => {
        actionConfirmResolver = resolve;
      });
    }

    // Initialize dashboard with real stats
    document.addEventListener('DOMContentLoaded', function() {

      const superAvatarEl = document.getElementById('superAvatar');
      const superWelcomeNameEl = document.getElementById('superWelcomeName');
      if (superAvatarEl) {
        superAvatarEl.src = getSuperAvatarUrl(superAvatarFile);
        superAvatarEl.addEventListener('click', openSuperProfileModal);
      }
      if (superWelcomeNameEl) superWelcomeNameEl.textContent = `Welcome, ${superDisplayName}`;
      if (initialSuccessMessage) showActionToast(initialSuccessMessage, 'success');
      else if (initialErrorMessage) showActionToast(initialErrorMessage, 'error');
      initSuperAutoLogout(autoLogoutMinutes);

      // Update stats with passed data from backend
      const stats = <%- JSON.stringify(stats || {}) %>;
      document.getElementById('totalFiles').textContent = stats.totalFiles || '0';
      document.getElementById('totalUsers').textContent = stats.totalUsers || '0';
      document.getElementById('totalAdmins').textContent = stats.totalAdmins || '0';
      document.getElementById('systemActions').textContent = stats.systemActions || '0';
      document.getElementById('activeAdminAccounts').textContent = stats.activeAdminAccounts || '0';
      document.getElementById('activeUserAccounts').textContent = stats.activeUserAccounts || '0';
      document.getElementById('predictedUploads').textContent = stats.predictedNextMonthUploads || '0';
      document.getElementById('predictedUploadsLabel').textContent = stats.predictedNextMonthLabel || 'Next month';
      // Fetch the latest forecast on every page load. Previously this only
      // happened after saving settings, leaving the hard-coded zero visible.
      refreshSuperStats();

      const adminBranchFilterEl = document.getElementById('adminBranchFilter');
      const userBranchFilterEl = document.getElementById('userBranchFilter');
      const assignmentsData = <%- JSON.stringify(branchAdminAssignments || []) %>;
      const branchOptions = Array.from(new Set(
        (assignmentsData || []).map(item => item.branch).filter(Boolean)
      )).sort((a, b) => a.localeCompare(b));

      const populateBranchFilterOptions = (selectEl) => {
        if (!selectEl) return;
        branchOptions.forEach(branch => {
          const option = document.createElement('option');
          option.value = branch;
          option.textContent = branch;
          selectEl.appendChild(option);
        });
      };

      const applyBranchFilter = (tableBodyId, selectedBranch, colSpan) => {
        const tableBody = document.getElementById(tableBodyId);
        if (!tableBody) return;

        const existingFilterEmpty = tableBody.querySelector('.filter-empty-row');
        if (existingFilterEmpty) existingFilterEmpty.remove();

        const allRows = Array.from(tableBody.querySelectorAll('tr'));
        const dataRows = allRows.filter((row) => !row.classList.contains('base-empty-row'));
        if (dataRows.length === 0) return;

        let visibleCount = 0;
        dataRows.forEach((row) => {
          const rowBranch = row.getAttribute('data-branch') || '';
          const isVisible = !selectedBranch || rowBranch === selectedBranch;
          row.style.display = isVisible ? '' : 'none';
          if (isVisible) visibleCount += 1;
        });

        if (visibleCount === 0) {
          const emptyRow = document.createElement('tr');
          emptyRow.className = 'filter-empty-row';
          emptyRow.innerHTML = `<td colspan="${colSpan}">No accounts found for the selected branch.</td>`;
          tableBody.appendChild(emptyRow);
        }
      };

      window.superApplyBranchFilter = applyBranchFilter;

      populateBranchFilterOptions(adminBranchFilterEl);
      populateBranchFilterOptions(userBranchFilterEl);
      
      // Populate admins table
      const adminsData = <%- JSON.stringify(admins || []) %>;
      const adminTable = document.getElementById('adminTable');
      adminTable.innerHTML = '';
      if (adminsData && adminsData.length > 0) {
        adminsData.forEach((admin, index) => {
          const row = document.createElement('tr');
          row.style.setProperty('--row-index', index);
          const adminBranch = admin.branch || 'N/A';
          row.setAttribute('data-account-id', admin._id);
          row.setAttribute('data-email', admin.email || '');
          row.setAttribute('data-branch', admin.branch || '');
          const statusLabel = admin.active === false ? 'Inactive' : '<i class="ri-checkbox-circle-line text-success"></i> Active';
          row.innerHTML = `
            <td>${escapeHtml(admin._id)}</td>
            <td>${escapeHtml(admin.email)}</td>
            <td>${escapeHtml(adminBranch)}</td>
            <td>${statusLabel}</td>
            <td>
              <button onclick="resetAdminPassword(${escapeHtml(JSON.stringify(admin._id))}, ${escapeHtml(JSON.stringify(admin.email))})"><i class="ri-key-line"></i> Reset Password</button>
              <button onclick="deactivateSuperAdmin(${escapeHtml(JSON.stringify(admin._id))})"><i class="ri-forbid-line"></i> Deactivate</button>
              <button onclick="deleteSuperAccount(${escapeHtml(JSON.stringify(admin._id))}, ${escapeHtml(JSON.stringify(admin.email))})"><i class="ri-delete-bin-line"></i> Delete Account</button>
            </td>
          `;
          adminTable.appendChild(row);
        });
      } else {
        const emptyRow = document.createElement('tr');
        emptyRow.className = 'base-empty-row';
        emptyRow.innerHTML = '<td colspan="5">No admin accounts available to manage.</td>';
        adminTable.appendChild(emptyRow);
      }

      // Populate users table
      const usersData = <%- JSON.stringify(users || []) %>;
      const superUserTable = document.getElementById('superUserTable');
      superUserTable.innerHTML = '';
      const manageableUsers = Array.isArray(usersData)
        ? usersData.filter(user => user.role === 'user' || user.role === 'admin')
        : [];
      if (manageableUsers.length > 0) {
        manageableUsers.forEach((user, index) => {
          const row = document.createElement('tr');
          row.style.setProperty('--row-index', index);
          const userBranch = user.branch || 'N/A';
          row.setAttribute('data-account-id', user._id);
          row.setAttribute('data-email', user.email || '');
          row.setAttribute('data-branch', user.branch || '');
          const currentRoleLabel = user.role === 'admin' ? 'Admin' : 'User';
          const nextRole = user.role === 'admin' ? 'user' : 'admin';
          const roleActionLabel = user.role === 'admin' ? 'Demote to User' : 'Promote to Admin';
          const statusLabel = user.active === false ? 'Inactive' : '<i class="ri-checkbox-circle-line text-success"></i> Active';
          row.innerHTML = `
            <td>${escapeHtml(user._id)}</td>
            <td>${escapeHtml(user.email)}</td>
            <td>${escapeHtml(currentRoleLabel)}</td>
            <td>${escapeHtml(userBranch)}</td>
            <td>${statusLabel}</td>
