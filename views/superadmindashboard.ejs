    async function toggleSuperUserRole(userId, newRole) {
      const actionLabel = newRole === 'admin' ? 'promote this account to Admin' : 'demote this account to User';
      const confirmed = await showActionConfirm({
        title: 'Change Role',
        message: `Confirm to ${actionLabel}?`,
        confirmText: 'Confirm',
        cancelText: 'Cancel',
        danger: false
      });
      if (confirmed) {
        requestJson('/admin/user/role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, role: newRole })
        })
        .then(data => {
          if (data.success) {
            showActionToast(`Role updated to ${newRole}`, 'success');
            addAudit(`Role updated to ${newRole}`);
            const userRow = document.querySelector(`#superUserTable tr[data-account-id="${userId}"]`);
            if (userRow) {
              const becameAdmin = newRole === 'admin';
              const email = userRow.getAttribute('data-email') || (userRow.cells[1] ? userRow.cells[1].textContent.trim() : '');
              const branch = userRow.getAttribute('data-branch') || '';
              const branchLabel = userRow.cells[3] ? userRow.cells[3].textContent.trim() : 'N/A';
              const statusLabel = userRow.cells[4] ? userRow.cells[4].textContent.trim() : 'Active';

              if (userRow.cells[2]) userRow.cells[2].textContent = becameAdmin ? 'Admin' : 'User';
              const roleBtn = userRow.querySelector('button[onclick*="toggleSuperUserRole"]');
              if (roleBtn) {
                const nextRole = becameAdmin ? 'user' : 'admin';
                roleBtn.textContent = becameAdmin ? 'Demote to User' : 'Promote to Admin';
                roleBtn.setAttribute('onclick', `toggleSuperUserRole(${escapeHtml(JSON.stringify(userId))}, ${escapeHtml(JSON.stringify(nextRole))})`);
              }

              const adminTable = document.getElementById('adminTable');
              const existingAdminRow = document.querySelector(`#adminTable tr[data-account-id="${userId}"]`);
              if (becameAdmin) {
                if (!existingAdminRow && adminTable) {
                  const baseEmpty = adminTable.querySelector('.base-empty-row');
                  if (baseEmpty) baseEmpty.remove();

                  const newAdminRow = document.createElement('tr');
                  newAdminRow.setAttribute('data-account-id', userId);
                  newAdminRow.setAttribute('data-email', email);
                  newAdminRow.setAttribute('data-branch', branch);
                  newAdminRow.innerHTML = `
                    <td>${escapeHtml(userId)}</td>
                    <td>${escapeHtml(email)}</td>
                    <td>${escapeHtml(branchLabel || 'N/A')}</td>
                    <td>${escapeHtml(statusLabel)}</td>
