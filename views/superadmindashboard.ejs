    function viewGlobalFile(fileName) {
      const safeName = String(fileName || '').replace(/\\/g, '/').split('/').pop();
      if (!safeName) {
        showActionToast('Invalid file name.', 'error');
        return;
      }

      showActionConfirm({
        title: 'View File',
        message: `Do you want to view this file?\n\n${safeName}`,
        confirmText: 'View',
        cancelText: 'Cancel',
        danger: false
      }).then(result => {
        if (!result) return;
        const fileUrl = `/uploads/${encodeURIComponent(safeName)}?view=1`;
        const openedWindow = window.open(fileUrl, '_blank', 'noopener,noreferrer');
        if (!openedWindow) {
          showActionToast('Popup blocked. Allow popups to view files.', 'error');
          return;
        }
        showActionToast(`Opening file: ${safeName}`, 'info');
      });
    }

    function downloadGlobalFile(fileName) {
      const safeName = String(fileName || '').replace(/\\/g, '/').split('/').pop();
      if (!safeName) {
        showActionToast('Invalid file name.', 'error');
        return;
      }

      showActionConfirm({
        title: 'Download File',
        message: `Do you want to download this file?\n\n${safeName}`,
        confirmText: 'Download',
        cancelText: 'Cancel',
        danger: false
      }).then(result => {
        if (!result) return;
        const link = document.createElement('a');
        link.href = `/uploads/${encodeURIComponent(safeName)}?download=1`;
        link.setAttribute('download', safeName);
        document.body.appendChild(link);
