    const MAX_AUDIT_ITEMS = 20;

    function addAudit(message) {
      const li = document.createElement('li');
      const now = new Date().toLocaleString();
      li.textContent = `${message} (${now})`;
      const auditList = document.getElementById('auditList');
      if (!auditList) return;
      auditList.insertBefore(li, auditList.firstChild);
      while (auditList.children.length > MAX_AUDIT_ITEMS) {
        auditList.removeChild(auditList.lastChild);
      }
    }
  </script>
  <%- include('partials/scripts', { email: email || '', fullname: fullname || '', role: role || '' }) %>

</body>
</html>

