                      <button onclick="deleteSuperAccount(${escapeHtml(JSON.stringify(userId))}, ${escapeHtml(JSON.stringify(email))})">Delete Account</button>
                    </td>
                  `;
                  adminTable.appendChild(newAdminRow);
                }
