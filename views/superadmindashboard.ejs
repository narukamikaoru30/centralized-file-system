    function ensureBaseEmptyRow(tableBodyId, colSpan, message) {
      const tableBody = document.getElementById(tableBodyId);
      if (!tableBody) return;
      const existing = tableBody.querySelector('.base-empty-row');
      if (existing) existing.remove();

      if (getTableDataRows(tableBodyId).length === 0) {
        const emptyRow = document.createElement('tr');
        emptyRow.className = 'base-empty-row';
