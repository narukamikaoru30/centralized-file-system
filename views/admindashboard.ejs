<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Admin Dashboard | PPO Regional FileSystem',
    description: 'Admin Dashboard - PPO Regional FileSystem',
    cssFiles: ['/css/dashboard.css', '/css/admin-dashboard.css', '/css/system-refresh.css']
  }) %>
</head>
<body class="admin-dashboard-page">

  <div class="dashboard-container">

    <%- include('partials/sidebar', {
      title: 'Admin Panel',
      sidebarIcon: 'settings-3-line',
      items: [
        { href: '#overview', label: 'Dashboard', icon: 'bar-chart-box-line', active: true },
        { href: '#files', label: 'Manage Files', icon: 'folder-3-line' },
        { href: '/auth/admin-user-uploads', label: 'User Uploads', icon: 'download-line' },
        { href: '#users', label: 'Manage Users', icon: 'group-line' },
        { href: '#audit', label: 'Audit Logs', icon: 'file-list-3-line' },
        { href: '#reports', label: 'Reports', icon: 'line-chart-line' }
      ]
    }) %>

    <!-- Main Content -->
    <main class="main-content">

      <header class="dashboard-header">
        <div class="admin-user-info">
          <img id="adminAvatar" src="" class="admin-avatar" alt="Admin Avatar" />
          <div>
            <h2 id="adminWelcomeName">Welcome, <%= fullname || 'Admin' %></h2>
            <p>
              <%= email %>
              <span id="adminTimeoutBadge" class="session-timeout-badge"><i class="ri-timer-line"></i> Session timeout: <%= (systemSettings && systemSettings.autoLogoutMinutes) ? systemSettings.autoLogoutMinutes : 30 %> min</span>
              <span id="adminRoleBadge" class="admin-role-badge role-admin">
                <i class="ri-shield-line"></i> Admin
              </span>
            </p>
          </div>
        </div>
      </header>

      <!-- Overview -->
      <section class="overview">
        <h2><i class="ri-bar-chart-box-line section-icon"></i> System Overview</h2>
        <div class="stats-grid">
          <div class="stat-card">
            <i class="ri-file-list-3-line stat-icon"></i>
            <h3>Total Files</h3>
            <p id="totalFiles">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-group-line stat-icon"></i>
            <h3>Total Users</h3>
            <p id="totalUsers">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-shield-user-line stat-icon"></i>
            <h3>Active Admins</h3>
            <p id="activeAdmins">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-upload-cloud-line stat-icon"></i>
            <h3>Recent Uploads</h3>
            <p id="recentUploads">0</p>
          </div>
          <div class="stat-card">
            <i class="ri-calendar-event-line stat-icon"></i>
            <h3>Next Month Forecast</h3>
            <p id="predictedUploads">0</p>
            <span id="predictedUploadsLabel" class="stat-caption">Next month</span>
          </div>
        </div>
      </section>

      <section class="forecast-overview card">
        <h2><i class="ri-bar-chart-box-line section-icon"></i> Upload Forecast</h2>
        <div class="forecast-grid">
          <div class="forecast-card compact">
            <p class="forecast-title">Current month uploads</p>
            <canvas id="uploadForecastChart" class="forecast-chart" width="400" height="200"></canvas>
            <ul id="uploadForecastList" class="forecast-list">
              <li>No forecast data available</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="analytics-overview">
        <h2><i class="ri-line-chart-line section-icon"></i> Usage &amp; Growth</h2>
        <div class="mini-metrics-grid">
          <div class="mini-metric">
            <span>Uploads this week</span>
            <strong id="weeklyUploadsMetric">0</strong>
          </div>
          <div class="mini-metric">
            <span>Current month</span>
            <strong id="currentMonthMetric">0</strong>
          </div>
          <div class="mini-metric">
            <span>Projected next month</span>
            <strong id="nextMonthMetric">0</strong>
          </div>
          <div class="mini-metric">
            <span>Active users</span>
            <strong id="activeUsersMetric">0</strong>
          </div>
        </div>
        <div class="chart-panel">
          <canvas id="usageGrowthChart" height="180"></canvas>
        </div>
      </section>

      <section class="engagement-overview">
        <h2><i class="ri-user-heart-line section-icon"></i> File Activity &amp; Engagement</h2>
        <div class="engagement-grid">
          <div class="engagement-panel">
            <h3>File category activity</h3>
            <div id="engagementCategoryList" class="engagement-category-list" aria-live="polite">
              <div class="empty-chart-state">Waiting for file activity...</div>
            </div>
          </div>
          <div class="engagement-panel">
            <h3>Recent activity feed</h3>
            <ul id="engagementFeed" class="engagement-feed">
              <li>Waiting for recent activity...</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- File Management -->
      <section class="file-management" id="files">
        <h2><i class="ri-folder-3-line section-icon"></i> All Uploaded Files</h2>
        <div class="filters">
          <input type="text" id="fileSearch" placeholder="Search files..." />
          <select id="fileCategoryFilter">
            <option value="all">All Categories</option>
            <option value="pdf">PDF</option>
            <option value="docx">DOCX</option>
            <option value="excel">Excel</option>
            <option value="image">Images</option>
          </select>
          <button onclick="clearFilters()"><i class="ri-refresh-line"></i> Clear Filters</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sortable" onclick="sortTable(0, 'fileTable')">File Name</th>
                <th class="sortable" onclick="sortTable(1, 'fileTable')">Category</th>
                <th class="sortable" onclick="sortTable(2, 'fileTable')">Uploaded By</th>
                <th class="sortable" onclick="sortTable(3, 'fileTable')">Branch</th>
                <th class="sortable" onclick="sortTable(4, 'fileTable')">Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="fileTable">
            </tbody>
          </table>
        </div>
      </section>

      <!-- User Management -->
      <section class="user-management" id="users">
        <h2><i class="ri-group-line section-icon"></i> Manage Users</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sortable" onclick="sortTable(0, 'userTable')">User ID</th>
                <th class="sortable" onclick="sortTable(1, 'userTable')">Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="userTable">
            </tbody>
          </table>
        </div>
      </section>

      <!-- Audit Logs -->
      <section class="audit-logs" id="audit">
        <h2><i class="ri-file-list-3-line section-icon"></i> Audit Logs</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sortable" onclick="sortTable(0, 'auditTable')">Action</th>
                <th class="sortable" onclick="sortTable(1, 'auditTable')">File/User</th>
                <th class="sortable" onclick="sortTable(2, 'auditTable')">Performed By</th>
                <th class="sortable" onclick="sortTable(3, 'auditTable')">Date</th>
              </tr>
            </thead>
            <tbody id="auditTable">
            </tbody>
          </table>
        </div>
      </section>

      <!-- Recent Activity -->
      <section class="reports" id="reports">
        <h2><i class="ri-notification-3-line section-icon"></i> Recent Activity</h2>
        <div class="activity-panel" id="recentActivityPanel">
          <% if ((recentNotifications || []).length) { %>
            <% recentNotifications.forEach(function(note) { %>
              <div class="activity-item">
                <div class="activity-icon"><%= note.icon || '🔔' %></div>
                <div class="activity-body">
                  <strong><%= note.message %></strong>
                  <div class="activity-meta"><%= new Date(note.date).toLocaleString() %></div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="activity-empty">No file activity yet.</div>
          <% } %>
        </div>
      </section>

      <!-- Reports -->
      <section class="reports" id="reports">
        <h2><i class="ri-line-chart-line section-icon"></i> System Reports</h2>
        <button type="button" onclick="generateReport()"><i class="ri-file-chart-line"></i> Generate Report</button>
        <div id="reportOutput">
          <p class="text-muted-sm report-placeholder">No reports generated yet.</p>
        </div>
      </section>

    </main>
  </div>

  <div id="adminProfileModal" class="profile-modal" role="dialog" aria-modal="true" aria-label="Admin Profile" onclick="if(event.target===this) closeAdminProfileModal()">
    <div class="profile-card">
      <div class="profile-head">
        <div>
          <h3>Admin Profile</h3>
          <p>Update your account details</p>
        </div>
        <button class="profile-close" type="button" onclick="closeAdminProfileModal()" aria-label="Close profile"><i class="ri-close-line"></i></button>
      </div>
      <div class="profile-body">
        <div class="profile-user">
          <img id="adminProfileAvatar" src="" class="profile-avatar" alt="Admin Avatar" />
          <div>
            <h4 id="adminProfileName"><%= fullname || 'Admin' %></h4>
            <p><%= email %></p>
          </div>
        </div>
        <div class="profile-list">
          <div class="profile-row"><span>Role</span><strong><%= role || 'admin' %></strong></div>
          <div class="profile-row"><span>Status</span><strong>Active</strong></div>
          <div class="profile-row"><span>Panel</span><strong>Admin</strong></div>
        </div>
        <form id="adminProfileForm" class="profile-form" enctype="multipart/form-data">
          <div class="profile-field">
            <label for="adminFullnameInput">Full Name</label>
            <input id="adminFullnameInput" type="text" value="<%= fullname || '' %>" required />
          </div>
          <div class="profile-field">
            <label for="adminPhotoInput">Profile Photo</label>
            <input id="adminPhotoInput" type="file" accept="image/*" />
          </div>
          <button id="adminProfileSaveBtn" class="profile-save-btn" type="submit">Save Changes</button>
        </form>
        <div id="adminProfileStatus" class="profile-status"></div>
      </div>
    </div>
  </div>

  <div id="actionConfirmModal" class="confirm-modal" aria-hidden="true">
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" aria-describedby="confirmMessage">
      <div id="confirmTitle" class="confirm-title">Confirm Action</div>
      <div id="confirmMessage" class="confirm-message">Are you sure?</div>
      <div class="confirm-actions">
        <button id="confirmCancelBtn" class="confirm-btn cancel" type="button">Cancel</button>
        <button id="confirmOkBtn" class="confirm-btn primary" type="button">Continue</button>
      </div>
    </div>
  </div>

  <div id="actionToast" class="action-toast" aria-live="polite"></div>

  <!-- JS (enhanced logic) -->
  <script src="/vendor/chart.umd.js"></script>
  <script src="/js/requestHelpers.js"></script>
  <script src="/js/toast.js"></script>
  <script>
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    let pendingAction = null;
    let actionToastTimer = null;
    let adminDisplayName = '<%= fullname || "Admin" %>';
    let adminAvatarFile = '<%= (typeof avatar !== "undefined" && avatar) ? avatar : "" %>';
    const initialSuccessMessage = <%- JSON.stringify(success || "") %>;
    const initialErrorMessage = <%- JSON.stringify(error || "") %>;
    const runtimeSystemSettings = <%- JSON.stringify(systemSettings || {}) %>;
    const PROFILE_PHOTO_MAX_SIZE = 2 * 1024 * 1024;
    const PROFILE_PHOTO_ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    let adminAutoLogoutMinutes = Number(runtimeSystemSettings.autoLogoutMinutes || 30);
    let adminInactivityWarnTimer = null;
    let adminInactivityLogoutTimer = null;
    let adminInactivityHandler = null;

    function initAdminAutoLogout(minutesInput) {
      const boundedMinutes = Math.min(120, Math.max(5, Number(minutesInput) || 30));
      adminAutoLogoutMinutes = boundedMinutes;
      const timeoutBadge = document.getElementById('adminTimeoutBadge');
      if (timeoutBadge) timeoutBadge.textContent = `Session timeout: ${boundedMinutes} min`;

      const timeoutMs = boundedMinutes * 60 * 1000;
      const warningLeadMs = Math.min(60 * 1000, Math.floor(timeoutMs / 2));

      const schedule = () => {
        if (adminInactivityWarnTimer) clearTimeout(adminInactivityWarnTimer);
        if (adminInactivityLogoutTimer) clearTimeout(adminInactivityLogoutTimer);

        adminInactivityWarnTimer = setTimeout(() => {
          const warnMinutes = warningLeadMs >= 60000
            ? `${Math.max(1, Math.round(warningLeadMs / 60000))} minute(s)`
            : `${Math.max(5, Math.round(warningLeadMs / 1000))} second(s)`;
          showActionToast(`Session expires in ${warnMinutes} due to inactivity.`, 'error');
        }, Math.max(1000, timeoutMs - warningLeadMs));

        adminInactivityLogoutTimer = setTimeout(() => {
          window.location.href = '/auth/logout';
        }, timeoutMs);
      };

      if (adminInactivityHandler) {
        ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
          document.removeEventListener(evt, adminInactivityHandler);
        });
      }

      adminInactivityHandler = () => schedule();
      ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach((evt) => {
        document.addEventListener(evt, adminInactivityHandler, { passive: true });
      });

      schedule();
    }

    function getAdminAvatarUrl(avatarFilename) {
      if (!avatarFilename) return 'https://via.placeholder.com/56';
      // Sanitize filename: allow only alphanumeric, dash, underscore, dot
      const sanitized = String(avatarFilename).replace(/[^a-zA-Z0-9._-]/g, '_');
      return `/uploads/${encodeURIComponent(sanitized)}`;
    }

    async function openAdminProfileModal() {
      try {
        // Fetch fresh profile data to avoid stale values in multi-tab scenario
        const response = await fetch('/auth/user/profile');
        const data = await response.json();
        if (data.success) {
          adminDisplayName = data.fullname || adminDisplayName;
          adminAvatarFile = data.avatar || adminAvatarFile;
        }
      } catch (err) {
        console.warn('Failed to fetch current profile, using cached values:', err);
      }
      
      const modal = document.getElementById('adminProfileModal');
      const headerAvatar = document.getElementById('adminAvatar');
      const profileAvatar = document.getElementById('adminProfileAvatar');
      const nameEl = document.getElementById('adminProfileName');
      const inputEl = document.getElementById('adminFullnameInput');
      const statusEl = document.getElementById('adminProfileStatus');
      if (headerAvatar) {
        headerAvatar.src = getAdminAvatarUrl(adminAvatarFile);
        headerAvatar.onerror = function() { this.src = 'https://via.placeholder.com/56'; };
      }
      if (profileAvatar) {
        profileAvatar.src = getAdminAvatarUrl(adminAvatarFile);
        profileAvatar.onerror = function() { this.src = 'https://via.placeholder.com/56'; };
      }
      if (nameEl) nameEl.textContent = adminDisplayName;
      if (inputEl) inputEl.value = adminDisplayName;
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.className = 'profile-status';
      }
      if (modal) modal.classList.add('show');
    }

    function closeAdminProfileModal() {
      const modal = document.getElementById('adminProfileModal');
      if (modal) {
        modal.classList.remove('show');
        // Reset form state to avoid confusion with unsaved changes
        const form = document.getElementById('adminProfileForm');
        if (form) form.reset();
        const statusEl = document.getElementById('adminProfileStatus');
        if (statusEl) {
          statusEl.textContent = '';
          statusEl.className = 'profile-status';
        }
        // Reset inputs to current values
        const fullnameEl = document.getElementById('adminFullnameInput');
        if (fullnameEl) fullnameEl.value = adminDisplayName;
        const photoEl = document.getElementById('adminPhotoInput');
        if (photoEl) photoEl.value = '';
      }
    }

    function openActionConfirm(title, message, confirmText, variant, onConfirm) {
      const modal = document.getElementById('actionConfirmModal');
      const titleEl = document.getElementById('confirmTitle');
      const messageEl = document.getElementById('confirmMessage');
      const okBtn = document.getElementById('confirmOkBtn');

      titleEl.textContent = title || 'Confirm Action';
      messageEl.textContent = message || 'Please confirm this action.';
      okBtn.textContent = confirmText || 'Continue';
      okBtn.classList.remove('primary', 'danger');
      okBtn.classList.add(variant === 'danger' ? 'danger' : 'primary');

      pendingAction = typeof onConfirm === 'function' ? onConfirm : null;
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeActionConfirm() {
      const modal = document.getElementById('actionConfirmModal');
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      pendingAction = null;
    }

    function confirmActionProceed() {
      const action = pendingAction;
      closeActionConfirm();
      if (action) action();
    }

    function showActionToast(message, type = 'info') {
      const toast = document.getElementById('actionToast');
      if (!toast) return;
      toast.textContent = message;
      toast.className = `action-toast ${type}`;
      requestAnimationFrame(() => toast.classList.add('show'));
      if (actionToastTimer) clearTimeout(actionToastTimer);
      actionToastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function getExtensionCategory(filename) {
      const ext = String(filename || '').toLowerCase().split('.').pop();
      if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'].includes(ext)) return 'image';
      if (ext === 'pdf') return 'pdf';
      if (ext === 'docx' || ext === 'doc') return 'docx';
      if (['xls', 'xlsx', 'csv'].includes(ext)) return 'excel';
      return 'other';
    }

    function getCategoryLabel(category) {
      return ({ pdf: 'PDF', docx: 'DOCX', excel: 'EXCEL', image: 'IMAGE' })[category] || 'OTHER';
    }

    function formatDashboardDate(value) {
      if (!value) return '—';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '—' : date.toISOString().split('T')[0];
    }

    document.addEventListener('DOMContentLoaded', function() {
      const adminAvatarEl = document.getElementById('adminAvatar');
      const adminWelcomeNameEl = document.getElementById('adminWelcomeName');
      if (adminAvatarEl) {
        adminAvatarEl.src = getAdminAvatarUrl(adminAvatarFile);
        adminAvatarEl.onerror = function() { this.src = 'https://via.placeholder.com/56'; };
        adminAvatarEl.addEventListener('click', openAdminProfileModal);
      }
      if (adminWelcomeNameEl) adminWelcomeNameEl.textContent = `Welcome, ${adminDisplayName}`;
      if (initialSuccessMessage) showActionToast(initialSuccessMessage, 'success');
      else if (initialErrorMessage) showActionToast(initialErrorMessage, 'error');
      initAdminAutoLogout(adminAutoLogoutMinutes);

      const modal = document.getElementById('actionConfirmModal');
      const cancelBtn = document.getElementById('confirmCancelBtn');
      const okBtn = document.getElementById('confirmOkBtn');
      if (cancelBtn) cancelBtn.addEventListener('click', closeActionConfirm);
      if (okBtn) okBtn.addEventListener('click', confirmActionProceed);
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeActionConfirm();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeActionConfirm();
          closeAdminProfileModal();
        }
      });

      const profileForm = document.getElementById('adminProfileForm');
      if (profileForm) {
        profileForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const fullnameEl = document.getElementById('adminFullnameInput');
          const photoEl = document.getElementById('adminPhotoInput');
          const statusEl = document.getElementById('adminProfileStatus');
          const saveBtn = document.getElementById('adminProfileSaveBtn');
          const fullname = (fullnameEl?.value || '').trim();

          if (!fullname) {
            if (statusEl) { statusEl.textContent = 'Please enter your full name.'; statusEl.className = 'profile-status error'; }
            return;
          }
          if (fullname.length > 80) {
            if (statusEl) { statusEl.textContent = 'Full name must be 80 characters or fewer.'; statusEl.className = 'profile-status error'; }
            return;
          }

          const selectedPhoto = photoEl?.files?.[0];
          if (selectedPhoto) {
            // Validate file extension matches allowed types
            const ext = selectedPhoto.name.toLowerCase().split('.').pop();
            const ALLOWED_EXTS = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
            if (!ALLOWED_EXTS.includes(ext)) {
              if (statusEl) { statusEl.textContent = 'Invalid file extension. Allowed: JPG, PNG, GIF, WEBP'; statusEl.className = 'profile-status error'; }
              return;
            }
            if (!PROFILE_PHOTO_ALLOWED_TYPES.includes(selectedPhoto.type)) {
              if (statusEl) { statusEl.textContent = 'Only JPG, PNG, GIF, or WEBP images are allowed.'; statusEl.className = 'profile-status error'; }
              return;
            }
            if (selectedPhoto.size > PROFILE_PHOTO_MAX_SIZE) {
              if (statusEl) { statusEl.textContent = 'Profile photo must be 2MB or smaller.'; statusEl.className = 'profile-status error'; }
              return;
            }
          }

          const formData = new FormData();
          formData.append('fullname', fullname);
          if (selectedPhoto) formData.append('profilePhoto', selectedPhoto);

          // Disable all inputs during save
          const inputsToDisable = [fullnameEl, photoEl];
          inputsToDisable.forEach(inp => { if (inp) inp.disabled = true; });
          if (saveBtn) saveBtn.disabled = true;
          if (statusEl) { statusEl.textContent = 'Saving profile...'; statusEl.className = 'profile-status'; }

          try {
            const data = await requestJson('/auth/user/profile', { method: 'POST', body: formData });
            if (!data.success) throw new Error(data.message || 'Unable to update profile');

            adminDisplayName = data.fullname || adminDisplayName;
            adminAvatarFile = typeof data.avatar !== 'undefined' ? data.avatar : adminAvatarFile;

            const headerAvatar = document.getElementById('adminAvatar');
            const profileAvatar = document.getElementById('adminProfileAvatar');
            const profileName = document.getElementById('adminProfileName');
            const headerTitle = document.getElementById('adminWelcomeName');
            if (headerAvatar) headerAvatar.src = getAdminAvatarUrl(adminAvatarFile);
            if (profileAvatar) profileAvatar.src = getAdminAvatarUrl(adminAvatarFile);
            if (profileName) profileName.textContent = adminDisplayName;
            if (headerTitle) headerTitle.textContent = `Welcome, ${adminDisplayName}`;
            if (photoEl) photoEl.value = '';
            if (statusEl) { statusEl.textContent = 'Profile updated successfully.'; statusEl.className = 'profile-status success'; }
          } catch (err) {
            if (statusEl) { statusEl.textContent = err.message || 'Unable to update profile'; statusEl.className = 'profile-status error'; }
          } finally {
            // Re-enable inputs after save
            const inputsToDisable = [fullnameEl, photoEl];
            inputsToDisable.forEach(inp => { if (inp) inp.disabled = false; });
            if (saveBtn) saveBtn.disabled = false;
          }
        });
      }

      // ===== DASHBOARD STATS AND TABLES SETUP =====
      // Initialize dashboard with real stats
      // Update stats with passed data from backend
      const stats = <%- JSON.stringify(stats || {}) %>;
      document.getElementById('totalFiles').textContent = stats.totalFiles || '0';
      document.getElementById('totalUsers').textContent = stats.totalUsers || '0';
      document.getElementById('activeAdmins').textContent = stats.activeAdmins || '0';
      document.getElementById('recentUploads').textContent = stats.recentUploads || '0';
      document.getElementById('predictedUploads').textContent = stats.predictedNextMonthUploads || '0';
      document.getElementById('predictedUploadsLabel').textContent = stats.predictedNextMonthLabel || 'Next month';
      const forecastListEl = document.getElementById('uploadForecastList');
      const forecastChartEl = document.getElementById('uploadForecastChart');
      const forecastItems = Array.isArray(stats.uploadForecast) ? stats.uploadForecast : [];

      if (forecastListEl) {
        forecastListEl.innerHTML = forecastItems.length
          ? forecastItems.map(item => `<li><strong>${escapeHtml(item.label)}:</strong> ${Number(item.count)}</li>`).join('')
          : '<li>No forecast data available</li>';
      }

      if (forecastChartEl && window.Chart) {
        const labels = forecastItems.map(item => item.label);
        const dataPoints = forecastItems.map(item => Number(item.count));

        if (window.uploadForecastChartInstance) {
          window.uploadForecastChartInstance.destroy();
        }

        window.uploadForecastChartInstance = new Chart(forecastChartEl, {
          type: 'bar',
          data: {
            labels,
            datasets: [{
              label: 'Uploads',
              data: dataPoints,
              backgroundColor: 'rgba(51, 102, 255, 0.45)',
              borderColor: 'rgba(51, 102, 255, 0.9)',
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0 } }
            }
          }
        });
      }

      const filesData = <%- JSON.stringify(files || []) %>;
      const usersData = <%- JSON.stringify(users || []) %>;
      const auditLogsData = <%- JSON.stringify(auditLogs || []) %>;

      function summarizeCategoryActivity(fileList) {
        const summary = {};
        fileList.forEach(file => {
          const rawName = file.originalName || file.filename || '';
          const category = getExtensionCategory(rawName);
          summary[category] = (summary[category] || 0) + 1;
        });

        return Object.entries(summary).map(([category, count]) => ({
          category,
          label: getCategoryLabel(category),
          count
        }));
      }

      function renderUsageGrowthInsights(currentStats, fileList) {
        const currentMonthUploads = Number(currentStats?.currentMonthUploads || 0);
        const nextMonthUploads = Number(currentStats?.predictedNextMonthUploads || 0);
        const weeklyUploads = Array.isArray(currentStats?.uploadForecast)
          ? currentStats.uploadForecast.slice(-7).reduce((sum, item) => sum + Number(item.count || 0), 0)
          : 0;
        const activeUsers = Number(document.getElementById('totalUsers')?.textContent || 0);

        const weeklyEl = document.getElementById('weeklyUploadsMetric');
        const currentMonthEl = document.getElementById('currentMonthMetric');
        const nextMonthEl = document.getElementById('nextMonthMetric');
        const activeUsersEl = document.getElementById('activeUsersMetric');

        if (weeklyEl) weeklyEl.textContent = weeklyUploads;
        if (currentMonthEl) currentMonthEl.textContent = currentMonthUploads;
        if (nextMonthEl) nextMonthEl.textContent = nextMonthUploads;
        if (activeUsersEl) activeUsersEl.textContent = activeUsers;

        const usageCanvas = document.getElementById('usageGrowthChart');
        if (usageCanvas && window.Chart) {
          const forecastData = Array.isArray(currentStats?.uploadForecast) ? currentStats.uploadForecast : [];
          const labels = forecastData.map(item => item.label || '');
          const values = forecastData.map(item => Number(item.count || 0));
          const hasData = labels.length > 0 && values.some(value => value > 0);

          const usageWrap = usageCanvas.parentElement;
          const existingUsageEmpty = usageWrap?.querySelector('.empty-chart-state');
          if (existingUsageEmpty) existingUsageEmpty.remove();
          usageCanvas.style.display = 'block';

          if (window.usageGrowthChartInstance) {
            window.usageGrowthChartInstance.destroy();
          }

          if (!hasData) {
            usageCanvas.style.display = 'none';
            if (usageWrap) {
              const emptyState = document.createElement('div');
              emptyState.className = 'empty-chart-state';
              emptyState.textContent = 'No upload activity yet. Once files are uploaded, the usage trend will appear here.';
              usageWrap.appendChild(emptyState);
            }
          } else {
            window.usageGrowthChartInstance = new Chart(usageCanvas, {
              type: 'line',
              data: {
                labels,
                datasets: [{
                  label: 'Uploads',
                  data: values,
                  borderColor: '#d4af37',
                  backgroundColor: 'rgba(212, 175, 55, 0.15)',
                  borderWidth: 3,
                  tension: 0.35,
                  fill: true
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                  y: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: { legend: { display: false } }
              }
            });
          }
        }

        const engagementList = document.getElementById('engagementCategoryList');
        if (engagementList) {
          const categorySummary = summarizeCategoryActivity(fileList);
          const totalFiles = categorySummary.reduce((sum, item) => sum + item.count, 0);
          engagementList.innerHTML = '';

          if (!categorySummary.length || totalFiles === 0) {
            engagementList.innerHTML = '<div class="empty-chart-state">No file activity yet. Uploads will appear here once users start sharing files.</div>';
          } else {
            categorySummary
              .sort((a, b) => b.count - a.count)
              .forEach(item => {
                const percentage = Math.round((item.count / totalFiles) * 100);
                const row = document.createElement('div');
                row.className = 'engagement-category-row';
                row.innerHTML = `
                  <div class="engagement-category-heading">
                    <span>${escapeHtml(item.label)}</span>
                    <strong>${item.count} <small>${percentage}%</small></strong>
                  </div>
                  <div class="engagement-category-track" aria-hidden="true">
                    <span style="width: ${percentage}%"></span>
                  </div>
                `;
                engagementList.appendChild(row);
              });
          }
        }

        const activityFeed = document.getElementById('engagementFeed');
        if (activityFeed) {
          const feedItems = Array.isArray(currentStats?.uploadForecast) && currentStats.uploadForecast.length
            ? currentStats.uploadForecast.slice(-3).map(item => `Uploads in ${item.label}: ${item.count}`)
            : ['No usage data available yet.'];

          activityFeed.innerHTML = feedItems.map(item => `<li>${escapeHtml(item)}</li>`).join('');
        }
      }

      repopulateFileTable(filesData);
      repopulateUserTable(usersData);
      repopulateAuditTable(auditLogsData);
      renderUsageGrowthInsights(stats, filesData);
      // The API provides fresh data even if the values passed to this template are stale.
      refreshDashboardData({ silent: true });

      const fileSearchInput = document.getElementById('fileSearch');
      const fileCategoryFilter = document.getElementById('fileCategoryFilter');
      let searchTimeout = null;
      if (fileSearchInput) {
        fileSearchInput.addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => filterFiles(), 300);
        });
      }
      if (fileCategoryFilter) {
        fileCategoryFilter.addEventListener('change', filterFiles);
      }

      // Set animation delay for table rows
      document.querySelectorAll('tbody tr').forEach((row, index) => {
        row.style.setProperty('--row-index', index);
      });
      
      // Navigation menu active state
      document.querySelectorAll('.sidebar ul li a').forEach(link => {
        link.addEventListener('click', function(e) {
          document.querySelectorAll('.sidebar ul li a').forEach(l => l.classList.remove('active'));
          this.classList.add('active');
        });
      });
    }); // End of consolidated DOMContentLoaded

    // Validate currentAdminRole with fallback
    const currentAdminRole = '<%= role || "user" %>';
    const validAdminRoles = ['user', 'admin', 'super_admin'];
    if (!currentAdminRole || !validAdminRoles.includes(currentAdminRole)) {
      console.warn('Invalid admin role detected:', currentAdminRole);
    }

    // Table sorting functionality
    let sortOrder = {};

    function sortTable(columnIndex, tableId) {
      const table = document.getElementById(tableId);
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      // Early return for empty table
      if (rows.length === 0) {
        return;
      }
      
      const header = table.querySelectorAll('th')[columnIndex];
      
      // Determine sort direction
      const isAsc = !sortOrder[tableId + '-' + columnIndex];
      sortOrder[tableId + '-' + columnIndex] = isAsc;
      
      // Clear sort indicators
      table.querySelectorAll('th').forEach(th => {
        th.classList.remove('sort-asc', 'sort-desc');
      });
      
      // Set current header indicator
      header.classList.add(isAsc ? 'sort-asc' : 'sort-desc');
      
      // Sort rows
      rows.sort((a, b) => {
        const aText = a.cells[columnIndex].textContent.trim().toLowerCase();
        const bText = b.cells[columnIndex].textContent.trim().toLowerCase();
        
        // Try numeric sort first
        const aNum = parseFloat(aText);
        const bNum = parseFloat(bText);
        
        if (!isNaN(aNum) && !isNaN(bNum)) {
          return isAsc ? aNum - bNum : bNum - aNum;
        }
        
        // Fall back to string sort
        return isAsc ? aText.localeCompare(bText) : bText.localeCompare(aText);
      });
      
      // Re-append sorted rows
      rows.forEach((row, index) => {
        row.style.setProperty('--row-index', index);
        tbody.appendChild(row);
      });
    }

    function viewAdminFile(fileName) {
      if (!fileName) {
        showActionToast('File not found', 'error');
        return;
      }
      openActionConfirm(
        'View File',
        `Do you want to view this file?\n\n${fileName}`,
        'View',
        'primary',
        function() {
          window.open(`/uploads/${encodeURIComponent(fileName)}?view=1`, '_blank');
        }
      );
    }

    function downloadAdminFile(fileName) {
      if (!fileName) {
        showActionToast('File not found', 'error');
        return;
      }
      openActionConfirm(
        'Download File',
        `Do you want to download this file?\n\n${fileName}`,
        'Download',
        'primary',
        function() {
          const okBtn = document.getElementById('confirmOkBtn');
          const originalText = okBtn.textContent;
          okBtn.disabled = true;
          okBtn.textContent = '📥 Downloading...';
          showActionToast(`📥 Downloading ${fileName}...`, 'info');
          
          const link = document.createElement('a');
          link.href = `/uploads/${encodeURIComponent(fileName)}?download=1`;
          link.setAttribute('download', fileName);
          document.body.appendChild(link);
          link.click();
          link.remove();
          
          setTimeout(() => {
            showActionToast('✅ Download complete', 'success');
            okBtn.disabled = false;
            okBtn.textContent = originalText;
          }, 1000);
        }
      );
    }

    // Safe extraction of RequestHelpers with error handling
    if (!window.RequestHelpers) {
      console.error('RequestHelpers library failed to load - dashboard may be limited');
      showActionToast('⚠️ Some dashboard features may not be available', 'error');
    }
    const { requestJson, postNoBody, postJson } = window.RequestHelpers || {
      requestJson: async () => { throw new Error('Request helpers not loaded'); },
      postNoBody: async () => { throw new Error('Request helpers not loaded'); },
      postJson: async () => { throw new Error('Request helpers not loaded'); }
    };

    // Track concurrent file operations to prevent race conditions
    let fileOperationInProgress = {};
    let roleChangeInProgress = {};

    function renderRecentNotifications(notifications) {
      const panel = document.getElementById('recentActivityPanel');
      if (!panel) return;

      if (!Array.isArray(notifications) || notifications.length === 0) {
        panel.innerHTML = '<div class="activity-empty">No file activity yet.</div>';
        return;
      }

      panel.innerHTML = notifications.map((note) => {
        const icon = note.icon || '🔔';
        const message = escapeHtml(note.message || 'New file activity');
        const date = note.date ? new Date(note.date).toLocaleString() : '';

        return `
          <div class="activity-item">
            <div class="activity-icon">${icon}</div>
            <div class="activity-body">
              <strong>${message}</strong>
              <div class="activity-meta">${date}</div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Refresh dashboard data via API instead of full page reload
    async function refreshDashboardData({ silent = false } = {}) {
      try {
        if (!silent) showActionToast('Refreshing dashboard...', 'info');
        const response = await fetch('/admin/dashboard/data', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        });
        if (!response.ok) {
          throw new Error(`Server returned ${response.status}: ${response.statusText}`);
        }
        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Failed to fetch dashboard data');
        }
        
        // Update stats
        if (data.stats) {
          document.getElementById('totalFiles').textContent = data.stats.totalFiles ?? '0';
          document.getElementById('totalUsers').textContent = data.stats.totalUsers ?? '0';
          document.getElementById('activeAdmins').textContent = data.stats.activeAdmins ?? '0';
          document.getElementById('recentUploads').textContent = data.stats.recentUploads ?? '0';
          document.getElementById('predictedUploads').textContent = data.stats.predictedNextMonthUploads ?? '0';
          document.getElementById('predictedUploadsLabel').textContent = data.stats.predictedNextMonthLabel || 'Next month';
        }
        
        // Refresh tables with updated data
        repopulateFileTable(data.files);
        repopulateUserTable(data.users);
        repopulateAuditTable(data.auditLogs);
        renderRecentNotifications(data.recentNotifications);
        renderUsageGrowthInsights(data.stats || {}, data.files || []);
        
        if (!silent) showActionToast('Dashboard refreshed', 'success');
      } catch (err) {
        console.error('Failed to refresh dashboard data:', err);
        if (!silent) showActionToast(`⚠️ Could not refresh data: ${err.message}. Try refreshing the page.`, 'error');
        // Do NOT auto-reload; let user decide
      }
    }

    function repopulateFileTable(filesData) {
      const fileTable = document.getElementById('fileTable');
      if (!fileTable) return;
      fileTable.innerHTML = '';
      if (filesData && filesData.length > 0) {
        filesData.forEach((file, index) => {
          const row = document.createElement('tr');
          row.style.setProperty('--row-index', index);
          const extCategory = getExtensionCategory(file.filename);
          row.setAttribute('data-category', extCategory);
          const ownerName = file.uploadedBy?.fullname || file.owner?.fullname || 'Unknown';
          const ownerEmail = file.uploadedBy?.email || file.owner?.email || 'N/A';
          const branchName = file.branch || file.uploadedBy?.branch || file.owner?.branch || 'N/A';
          const uploadDate = formatDashboardDate(file.uploadedAt || file.createdAt);
          const displayName = file.originalName || file.filename || 'Unnamed file';
          row.innerHTML = `
            <td title="${escapeHtml(displayName)}">${escapeHtml(displayName)}</td>
            <td>${getCategoryLabel(extCategory)}</td>
            <td>${escapeHtml(ownerName)} (${escapeHtml(ownerEmail)})</td>
            <td>${escapeHtml(branchName)}</td>
            <td>${escapeHtml(uploadDate)}</td>
            <td class="actions-cell">
              <button onclick="viewAdminFile(${escapeHtml(JSON.stringify(file.filename))})"><i class="ri-eye-line"></i> View</button>
              <button onclick="downloadAdminFile(${escapeHtml(JSON.stringify(file.filename))})"><i class="ri-download-line"></i> Download</button>
              <button onclick="deleteAdminFile(${escapeHtml(JSON.stringify(file._id))})"><i class="ri-delete-bin-line"></i> Delete</button>
            </td>
          `;
          fileTable.appendChild(row);
        });
      } else {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = '<td colspan="6">No files uploaded yet.</td>';
        fileTable.appendChild(emptyRow);
      }
    }

    function repopulateUserTable(usersData) {
      const userTable = document.getElementById('userTable');
      if (!userTable) return;
      userTable.innerHTML = '';
      const manageableUsers = Array.isArray(usersData)
        ? usersData.filter(user => user.role === 'user')
        : [];
      if (manageableUsers.length > 0) {
        manageableUsers.forEach((user, index) => {
          const row = document.createElement('tr');
          row.style.setProperty('--row-index', index);
          const roleLabel = 'User';
          const userStatus = user.status || 'active';
          const statusBadge = userStatus === 'active'
            ? `<span class="badge badge-success">${escapeHtml(userStatus)}</span>`
            : `<span class="badge badge-danger">${escapeHtml(userStatus)}</span>`;
          row.innerHTML = `
            <td>${escapeHtml(user._id)}</td>
            <td>${escapeHtml(user.email)}</td>
            <td>${escapeHtml(roleLabel)}</td>
            <td>${statusBadge}</td>
            <td>
              <button onclick="deactivateAdminUser(${escapeHtml(JSON.stringify(user._id))})"><i class="ri-forbid-line"></i> Deactivate</button>
            </td>
          `;
          userTable.appendChild(row);
        });
      } else {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = '<td colspan="5">No regular users available to manage.</td>';
        userTable.appendChild(emptyRow);
      }
    }

    function repopulateAuditTable(auditLogsData) {
      const auditTable = document.getElementById('auditTable');
      if (!auditTable) return;
      auditTable.innerHTML = '';
      if (auditLogsData && auditLogsData.length > 0) {
        auditLogsData.forEach((log, index) => {
          const row = document.createElement('tr');
          row.style.setProperty('--row-index', index);
          // Handle both AuditLog model (with timestamp, user object) and old Report model
          const logDate = formatDashboardDate(log.timestamp || log.date || log.createdAt);
          const userName = typeof log.user === 'object' && log.user?.fullname 
            ? log.user.fullname 
            : (typeof log.user === 'string' ? log.user : 'Unknown User');
          const fileOrTarget = log.details || log.filename || 'N/A';
          row.innerHTML = `
            <td>${escapeHtml(log.action || 'N/A')}</td>
            <td>${escapeHtml(fileOrTarget)}</td>
            <td>${escapeHtml(userName)}</td>
            <td>${escapeHtml(logDate)}</td>
          `;
          auditTable.appendChild(row);
        });
      } else {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = '<td colspan="4">No audit logs recorded yet.</td>';
        auditTable.appendChild(emptyRow);
      }
    }

    function deleteAdminFile(fileId) {
      if (fileOperationInProgress[fileId]) {
        showActionToast('⏳ Operation already in progress for this file', 'warn');
        return;
      }
      openActionConfirm(
        'Delete File',
        'Do you want to delete this file?\n\nThis action cannot be undone.',
        'Delete',
        'danger',
        async function() {
          fileOperationInProgress[fileId] = true;
          const okBtn = document.getElementById('confirmOkBtn');
          const originalText = okBtn.textContent;
          okBtn.disabled = true;
          okBtn.textContent = '⏳ Deleting...';
          
          try {
            const data = await postNoBody(`/admin/file/delete/${fileId}`);
            if (data.success) {
              showActionToast(data.message, 'success');
              await refreshDashboardData();
            } else {
              showActionToast(data.message, 'error');
            }
          } catch (err) {
            showActionToast(err.message || 'Delete failed', 'error');
          } finally {
            okBtn.disabled = false;
            okBtn.textContent = originalText;
            delete fileOperationInProgress[fileId];
          }
        }
      );
    }

    function updateAdminRole(userId, newRole) {
      if (roleChangeInProgress[userId]) {
        showActionToast('⏳ Role change already in progress', 'warn');
        return;
      }
      if (currentAdminRole !== 'super_admin') {
        showActionToast('Only Super Admin can manage user roles.', 'error');
        return;
      }
      // Validate role is one of the allowed values
      const validRoles = ['user', 'admin'];
      if (!validRoles.includes(newRole)) {
        showActionToast('❌ Invalid role selected', 'error');
        return;
      }
      const roleEmoji = { 'user': 'User', 'admin': 'Admin', 'super_admin': 'Super Admin' };
      openActionConfirm(
        'Update Role',
        `Change role to ${newRole}?`,
        'Update',
        'primary',
        async function() {
          roleChangeInProgress[userId] = true;
          const okBtn = document.getElementById('confirmOkBtn');
          const originalText = okBtn.textContent;
          okBtn.disabled = true;
          okBtn.textContent = '⏳ Updating...';
          
          try {
            const data = await postJson('/admin/user/role', { userId, role: newRole });
            if (data.success) {
              addAudit('Role Updated', `${userId} → ${newRole}`);
              showActionToast(`Role updated to ${roleEmoji[newRole]} ${newRole}`, 'success');
              await refreshDashboardData();
            } else {
              showActionToast(data.message, 'error');
            }
          } catch (err) {
            showActionToast(err.message || 'Role update failed', 'error');
          } finally {
            okBtn.disabled = false;
            okBtn.textContent = originalText;
            delete roleChangeInProgress[userId];
          }
        }
      );
    }

    function deactivateAdminUser(userId) {
      openActionConfirm(
        'Deactivate User',
        `Deactivate this user? They won't be able to login.`,
        'Deactivate',
        'danger',
        async function() {
          const okBtn = document.getElementById('confirmOkBtn');
          const originalText = okBtn.textContent;
          okBtn.disabled = true;
          okBtn.textContent = '⏳ Deactivating...';
          
          try {
            const data = await postNoBody(`/admin/user/deactivate/${userId}`);
            if (data.success) {
              addAudit('User Deactivated', userId);
              showActionToast('User deactivated', 'success');
              await refreshDashboardData();
            } else {
              showActionToast(data.message, 'error');
            }
          } catch (err) {
            showActionToast(err.message || 'Deactivation failed', 'error');
          } finally {
            okBtn.disabled = false;
            okBtn.textContent = originalText;
          }
        }
      );
    }

    async function generateReport() {
      const button = document.querySelector('.reports button');
      const originalText = button ? button.innerHTML : '';

      try {
        if (button) {
          button.disabled = true;
          button.innerHTML = '<i class="ri-loader-4-line ri-spin"></i> Generating...';
        }

        const response = await fetch('/admin/dashboard/reports/export.csv', {
          credentials: 'same-origin',
          headers: { Accept: 'text/csv' }
        });
        if (!response.ok) {
          let message = 'Unable to generate report';
          try {
            const payload = await response.json();
            message = payload.message || message;
          } catch (_) {}
          throw new Error(message);
        }

        const blob = await response.blob();
        const downloadUrl = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.download = `admin_report_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(downloadUrl);
        showActionToast('Admin report download is ready.', 'success');
      } catch (err) {
        showActionToast(err.message || 'Unable to generate report', 'error');
      } finally {
        if (button) {
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    }

    function renderReportSummary() {
      const reportDate = new Date().toLocaleString();
      document.getElementById('reportOutput').innerHTML = `
        <div class="report-card">
          <h3>System Report Generated</h3>
          <p><strong>Generated on:</strong> ${reportDate}</p>
          <hr>
          <ul>
            <li><strong>Total Files:</strong> <%= stats ? stats.totalFiles : 'N/A' %></li>
            <li><strong>Total Users:</strong> <%= stats ? stats.totalUsers : 'N/A' %></li>
            <li><strong>Recent Uploads:</strong> <%= stats ? stats.recentUploads : 'N/A' %></li>
            <li><strong>Actions Logged:</strong> <%= auditLogs ? auditLogs.length : 'N/A' %></li>
            <li><strong>System Uptime:</strong> 99.9%</li>
          </ul>
        </div>
      `;
    }

    function filterFiles() {
      const query = document.getElementById('fileSearch').value.toLowerCase();
      const category = document.getElementById('fileCategoryFilter').value;
      document.querySelectorAll('#fileTable tr').forEach(row => {
        if (row.cells.length < 2) return;
        const name = row.cells[0].textContent.toLowerCase();
        const cat = (row.getAttribute('data-category') || row.cells[1].textContent || '').toLowerCase();
        row.style.display =
          name.includes(query) && (category === 'all' || cat === category)
          ? '' : 'none';
      });
    }

    function clearFilters() {
      document.getElementById('fileSearch').value = '';
      document.getElementById('fileCategoryFilter').value = 'all';
      filterFiles();
    }

    function addAudit(action, target) {
      const row = document.createElement('tr');
      const today = new Date().toISOString().split('T')[0];
      const auditTableEl = document.getElementById('auditTable');
      if (!auditTableEl) return;
      const currentIndex = auditTableEl.rows.length;
      row.style.setProperty('--row-index', currentIndex);
      const tdAction = document.createElement('td');
      tdAction.textContent = action;
      const tdTarget = document.createElement('td');
      tdTarget.textContent = target;
      const tdUser = document.createElement('td');
      tdUser.textContent = adminDisplayName || 'Admin';  // Use dynamic value instead of hardcoded
      const tdDate = document.createElement('td');
      tdDate.textContent = today;
      row.appendChild(tdAction);
      row.appendChild(tdTarget);
      row.appendChild(tdUser);
      row.appendChild(tdDate);
      auditTableEl.appendChild(row);
    }
  </script>
  <%- include('partials/scripts', { email: email || '', fullname: fullname || '', role: role || '' }) %>

</body>
</html>
