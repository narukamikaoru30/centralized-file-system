<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Forgot Password | PPO Regional FileSystem',
    description: 'Forgot Password - PPO Regional FileSystem',
    cssFiles: ['/css/forgot-password.css', '/css/system-refresh.css']
  }) %>
</head>
<body>
  <div class="particles"><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div></div>
  <div class="gradient-orb gradient-orb-1"></div>
  <div class="gradient-orb gradient-orb-2"></div>
  <a href="/auth/login" class="back-link"><i class="ri-arrow-left-line"></i> Back to Login</a>

  <div class="container">
    <div class="card">
      <div class="header">
        <div class="logo-wrapper"><i class="ri-key-2-fill"></i></div>
        <h1>Forgot Password</h1>
        <p>Enter your email and we'll send you a reset link</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="banner success"><i class="ri-checkbox-circle-fill"></i> <%= success %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="banner error"><i class="ri-error-warning-fill"></i> <%= error %></div>
      <% } %>

      <form method="POST" action="/auth/forgot-password">
        <div class="form-group">
          <label for="email">Email Address</label>
          <div class="input-wrapper">
            <i class="ri-mail-line input-icon"></i>
            <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
          </div>
        </div>
        <button type="submit" class="submit-btn">Send Reset Link</button>
      </form>

      <div class="login-link">
        <a href="/auth/login"><i class="ri-arrow-left-line"></i> Back to Sign In</a>
      </div>
    </div>
  </div>
</body>
</html>
