<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Notifications | Centralized File System',
    description: 'Notifications - DOJ-PPA Centralized File System',
    cssFiles: ['/css/dashboard.css', '/css/notifications.css', '/css/system-refresh.css']
  }) %>
</head>
<body>
  <div class="dashboard-container">
    <%- include('partials/sidebar', {
      title: 'Dashboard',
      sidebarIcon: 'dashboard-line',
      role: typeof role !== 'undefined' ? role : 'user',
      items: [
        { href: '/auth/user', label: 'My Files', icon: 'folder-3-line' },
        { href: '/auth/notifications', label: 'Notifications', icon: 'notification-3-line', active: true },
        { href: '/auth/reports', label: 'Reports', icon: 'bar-chart-box-line' }
      ]
    }) %>

    <main class="main-content">
      <div class="card">
        <div class="notif-toolbar">
          <h2><i class="ri-mail-line"></i> Recent Notifications</h2>
          <button class="btn-mark-all" id="markAllBtn" style="display:none;" onclick="markAllRead()"><i class="ri-check-double-line"></i> Mark All Read</button>
        </div>

        <div id="notifLoader" class="chart-loader"><i class="ri-loader-4-line ri-spin"></i> Loading notifications...</div>
        <div id="notifList"></div>
        <div id="notifEmpty" class="empty-state" style="display:none;">
          <i class="ri-notification-off-line"></i>
          No new notifications
        </div>

        <!-- Pagination -->
        <div id="notifPagination" class="notif-pagination" style="display:none;">
          <button id="prevBtn" class="pagination-btn" onclick="changePage(-1)"><i class="ri-arrow-left-s-line"></i> Prev</button>
          <span id="pageInfo" class="page-info"></span>
          <button id="nextBtn" class="pagination-btn" onclick="changePage(1)">Next <i class="ri-arrow-right-s-line"></i></button>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/toast.js"></script>
  <script src="/js/theme.js"></script>
  <script src="/js/requestHelpers.js"></script>
  <script>
    /* ===== Notification icon map ===== */
    const ICON_MAP = {
      upload: 'ri-upload-2-line',
      delete: 'ri-delete-bin-line',
      system: 'ri-settings-3-line',
      security: 'ri-shield-line'
    };

    /* ===== Pagination state ===== */
    let currentPage = 1;
    const PAGE_SIZE = 15;

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    async function loadNotifications(page) {
      const loader = document.getElementById('notifLoader');
      const list = document.getElementById('notifList');
      const empty = document.getElementById('notifEmpty');
      const pagination = document.getElementById('notifPagination');
      const markAllBtn = document.getElementById('markAllBtn');

      loader.style.display = '';
      list.innerHTML = '';
      empty.style.display = 'none';

      try {
        const res = await fetch('/notifications?page=' + page + '&limit=' + PAGE_SIZE, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) throw new Error('Failed to load');
        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'Error');

        loader.style.display = 'none';
        const items = json.data || [];
        const pag = json.pagination || {};

        if (items.length === 0) {
          empty.style.display = '';
          pagination.style.display = 'none';
          markAllBtn.style.display = 'none';
          return;
        }

        markAllBtn.style.display = json.unreadCount > 0 ? '' : 'none';

        items.forEach(function(n, idx) {
          const iconClass = ICON_MAP[n.type] || 'ri-notification-3-line';
          const dateStr = n.date ? new Date(n.date).toDateString() : 'N/A';
          const div = document.createElement('div');
          div.className = 'notification-item' + (!n.read ? ' unread' : '');
          div.style.animationDelay = (0.05 * (idx + 1)) + 's';
          div.setAttribute('data-id', n._id);
          div.onclick = function() { markRead(div, n._id); };
          div.innerHTML =
            '<span class="notif-icon"><i class="ri-' + iconClass.replace('ri-', '') + '"></i></span>' +
            '<div class="notif-body">' +
              '<p>' + escapeHtml(n.message) + '</p>' +
              '<div class="notif-meta">' +
                '<span class="notification-date">' + escapeHtml(dateStr) + '</span>' +
                '<span class="notif-type ' + escapeHtml(n.type || 'general') + '">' + escapeHtml(n.type || 'general') + '</span>' +
              '</div>' +
            '</div>' +
            (!n.read ? '<span class="unread-dot"></span>' : '');
          list.appendChild(div);
        });

        // Pagination controls
        currentPage = pag.page || 1;
        var totalPages = pag.pages || 1;
        document.getElementById('pageInfo').textContent = 'Page ' + currentPage + ' of ' + totalPages;
        document.getElementById('prevBtn').disabled = currentPage <= 1;
        document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        pagination.style.display = totalPages > 1 ? '' : 'none';

      } catch (err) {
        loader.style.display = 'none';
        list.innerHTML = '<div class="empty-state"><i class="ri-error-warning-line"></i> Failed to load notifications</div>';
      }
    }

    function changePage(delta) {
      loadNotifications(currentPage + delta);
    }

    /* ===== Mark single notification as read ===== */
    async function getNotificationCsrfHeaders() {
      const headers = { 'Content-Type': 'application/json' };
      if (window.RequestHelpers) {
        let csrfToken = window.RequestHelpers.getCsrfToken();
        if (!csrfToken || window.RequestHelpers.isCsrfTokenExpired(csrfToken)) {
          csrfToken = await window.RequestHelpers.refreshCsrfToken();
        }
        if (csrfToken) {
          headers['X-CSRF-Token'] = csrfToken;
        }
      }
      return headers;
    }

    async function markRead(el, id) {
      if (!el.classList.contains('unread')) return;
      try {
        const res = await fetch('/notifications/mark-read', {
          method: 'POST',
          credentials: 'same-origin',
          headers: await getNotificationCsrfHeaders(),
          body: JSON.stringify({ ids: [id] })
        });
        if (res.ok) {
          el.classList.remove('unread');
          var dot = el.querySelector('.unread-dot');
          if (dot) dot.remove();
        }
      } catch (e) { /* silent */ }
    }

    /* ===== Mark all as read ===== */
    async function markAllRead() {
      try {
        const res = await fetch('/notifications/mark-read', {
          method: 'POST',
          credentials: 'same-origin',
          headers: await getNotificationCsrfHeaders(),
          body: JSON.stringify({ all: true })
        });
        if (res.ok) {
          document.querySelectorAll('.notification-item.unread').forEach(function(el) {
            el.classList.remove('unread');
            var dot = el.querySelector('.unread-dot');
            if (dot) dot.remove();
          });
          document.getElementById('markAllBtn').style.display = 'none';
        }
      } catch (e) { /* silent */ }
    }

    /* Initial load */
    loadNotifications(1);
  </script>
</body>
</html>
