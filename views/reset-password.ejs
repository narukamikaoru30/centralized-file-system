<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Reset Password | PPO Regional FileSystem',
    description: 'Reset Password - PPO Regional FileSystem',
    cssFiles: ['/css/reset-password.css', '/css/system-refresh.css']
  }) %>
</head>
<body>
  <div class="particles"><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div><div class="particle"></div></div>
  <div class="gradient-orb gradient-orb-1"></div>
  <div class="gradient-orb gradient-orb-2"></div>

  <div class="container">
    <div class="card">
      <div class="header">
        <div class="logo-wrapper"><i class="ri-lock-password-fill"></i></div>
        <h1>Reset Password</h1>
        <p>Create a strong new password for your account</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="banner error"><i class="ri-error-warning-fill"></i> <%= error %></div>
      <% } %>

      <form method="POST" action="/auth/reset-password/<%= token %>">
        <div class="form-group">
          <label for="password">New Password</label>
          <div class="input-wrapper">
            <i class="ri-lock-2-line input-icon"></i>
            <input type="password" id="password" name="password" placeholder="Enter new password" required minlength="8" />
            <button type="button" class="toggle-password" onclick="toggleVis('password', this)"><i class="ri-eye-off-line"></i></button>
          </div>
          <div class="strength-bar"><div class="seg"></div><div class="seg"></div><div class="seg"></div><div class="seg"></div></div>
          <div class="strength-label" id="strengthLabel"></div>
          <div class="requirements">
            <span class="req" data-req="length"><i class="ri-close-circle-line"></i> 8+ characters</span>
            <span class="req" data-req="upper"><i class="ri-close-circle-line"></i> Uppercase</span>
            <span class="req" data-req="lower"><i class="ri-close-circle-line"></i> Lowercase</span>
            <span class="req" data-req="number"><i class="ri-close-circle-line"></i> Number</span>
            <span class="req" data-req="special"><i class="ri-close-circle-line"></i> Special char</span>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <div class="input-wrapper">
            <i class="ri-lock-check-line input-icon"></i>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required minlength="8" />
            <button type="button" class="toggle-password" onclick="toggleVis('confirmPassword', this)"><i class="ri-eye-off-line"></i></button>
          </div>
          <div id="matchMsg" style="font-size:0.78rem; margin-top:4px; font-weight:600;"></div>
        </div>

        <button type="submit" class="submit-btn"><i class="ri-check-double-fill"></i> Reset Password</button>
      </form>

      <div class="login-link">
        <a href="/auth/login"><i class="ri-arrow-left-line"></i> Back to Sign In</a>
      </div>
    </div>
  </div>

  <script>
    function toggleVis(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') { input.type = 'text'; icon.className = 'ri-eye-line'; }
      else { input.type = 'password'; icon.className = 'ri-eye-off-line'; }
    }

    const pw = document.getElementById('password');
    const confirm = document.getElementById('confirmPassword');
    const segs = document.querySelectorAll('.strength-bar .seg');
    const label = document.getElementById('strengthLabel');
    const reqs = document.querySelectorAll('.req');
    const matchMsg = document.getElementById('matchMsg');

    const checks = {
      length: v => v.length >= 8,
      upper: v => /[A-Z]/.test(v),
      lower: v => /[a-z]/.test(v),
      number: v => /[0-9]/.test(v),
      special: v => /[^A-Za-z0-9]/.test(v)
    };

    const colors = ['#ef4444','#f97316','#eab308','#22c55e'];
    const labels = ['Weak','Fair','Good','Strong'];

    pw.addEventListener('input', () => {
      const v = pw.value;
      let score = 0;
      reqs.forEach(r => {
        const key = r.dataset.req;
        const met = checks[key](v);
        r.classList.toggle('met', met);
        r.querySelector('i').className = met ? 'ri-checkbox-circle-line' : 'ri-close-circle-line';
        if (met) score++;
      });
      const level = v.length === 0 ? 0 : Math.min(Math.ceil(score * 4 / 5), 4);
      segs.forEach((s, i) => { s.style.background = i < level ? colors[level - 1] : '#e5e7eb'; });
      label.textContent = v.length === 0 ? '' : labels[level - 1] || '';
      label.style.color = colors[level - 1] || '';
      checkMatch();
    });

    confirm.addEventListener('input', checkMatch);

    function checkMatch() {
      if (!confirm.value) { matchMsg.textContent = ''; return; }
      if (pw.value === confirm.value) { matchMsg.textContent = 'Passwords match'; matchMsg.style.color = '#22c55e'; }
      else { matchMsg.textContent = 'Passwords do not match'; matchMsg.style.color = '#ef4444'; }
    }
  </script>
</body>
</html>
